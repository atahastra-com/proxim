# Large third-party trees and generated root filesystem
linux/
linux-*/
busybox-*/
rootfs/
initramfs/

# Tarballs and boot images
*.tar.xz
*.tar.bz2
*.tar.gz
*.sha256
*.cpio.gz

# Built binaries and generated scripts
kosinit/kosinit
/init
/init.proof.sh
*.o

# Logs, fifos, timing crumbs
*.log
*-start.txt
*-end.txt
.qemu-stdin

# Rust build output
**/target/

# Rootfs install stamp
.busybox-rootfs-stamp

# Debian kos distro build output & third-party icon themes
distro/out/
distro/mnt/
distro/overlay/usr/share/icons/Deepin2022/

# Local proof screenshots of the distro desktop
/distro-shot.png
/distro-desktop.png

# Private OTA update signing keys and generated update artifacts
.keys/
updates-out/

# Local AI API keys (never commit secrets)
distro/overlay/home/*/.config/kos/ai.json
