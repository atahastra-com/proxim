# Default GNOME look for kos: dark (Deepin-style) desktop, kos wallpaper, no first-run tour,
# a single workspace, and the kos-shell extension enabled.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/kos/kos-wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/kos/kos-wallpaper.png'
picture-options='zoom'
primary-color='#0b1020'
secondary-color='#0b1020'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/kos/kos-wallpaper.png'
primary-color='#0b1020'

[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='blue'
gtk-theme='Adwaita'
icon-theme='bloom'
enable-hot-corners=false
clock-show-date=true
clock-show-weekday=true
enable-animations=false
show-battery-percentage=true

[org.gnome.desktop.session]
idle-delay=uint32 0

[org.gnome.desktop.peripherals.touchpad]
tap-to-click=true
click-method='areas'
two-finger-scrolling-enabled=true

[org.gnome.mutter]
dynamic-workspaces=false
overlay-key=''
experimental-features=['scale-monitor-framebuffer']

[org.gnome.desktop.wm.preferences]
num-workspaces=1
button-layout=':minimize,maximize,close'

[org.gnome.shell]
disable-user-extensions=false
enabled-extensions=['kos-shell@kos']
welcome-dialog-last-shown-version='99.0'
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Settings.desktop']

[org.gnome.desktop.search-providers]
disable-external=true

[org.gnome.software]
download-updates=false
download-updates-notify=false
