# Minimal plymouth script: a dark background and a centered "kos" logo.
bg = Image("background.png");
bg = bg.Scale(Window.GetWidth(), Window.GetHeight());
bg_sprite = Sprite(bg);
bg_sprite.SetZ(-10000);

logo = Image("logo.png");
logo_sprite = Sprite(logo);
logo_sprite.SetX(Window.GetWidth() / 2 - logo.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo.GetHeight() / 2);
