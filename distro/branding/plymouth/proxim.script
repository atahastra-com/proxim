# Proxim OS boot & offline-update splash (Atahastra).
# Normal boot/shutdown: black screen, Atahastra logo, "Proxim OS", iOS-style
# 12-spoke spinner, and ATAHASTRA footer.
# System update mode (plymouth change-mode --updates): hides the spinner and
# fills a sleek Apple-style white progress bar from 0% to 100%.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

W = Window.GetWidth();
H = Window.GetHeight();
X = Window.GetX();
Y = Window.GetY();

logo.image = Image("splash-logo.png");
logo.sprite = Sprite(logo.image);
logo.y = Y + H / 2 - logo.image.GetHeight() / 2 - 48;
logo.sprite.SetPosition(X + W / 2 - logo.image.GetWidth() / 2, logo.y, 10);
logo.sprite.SetOpacity(0);

name.image = Image("splash-name.png");
name.sprite = Sprite(name.image);
name.sprite.SetPosition(X + W / 2 - name.image.GetWidth() / 2, logo.y + logo.image.GetHeight() + 22, 10);
name.sprite.SetOpacity(0);

vendor.image = Image("splash-vendor.png");
vendor.sprite = Sprite(vendor.image);
vendor.sprite.SetPosition(X + W / 2 - vendor.image.GetWidth() / 2, Y + H - vendor.image.GetHeight() - 40, 10);
vendor.sprite.SetOpacity(0);

spin[0] = Image("spinner-00.png");
spin[1] = Image("spinner-01.png");
spin[2] = Image("spinner-02.png");
spin[3] = Image("spinner-03.png");
spin[4] = Image("spinner-04.png");
spin[5] = Image("spinner-05.png");
spin[6] = Image("spinner-06.png");
spin[7] = Image("spinner-07.png");
spin[8] = Image("spinner-08.png");
spin[9] = Image("spinner-09.png");
spin[10] = Image("spinner-10.png");
spin[11] = Image("spinner-11.png");
spinner.sprite = Sprite(spin[0]);
spinner.sprite.SetPosition(X + W / 2 - spin[0].GetWidth() / 2, logo.y + logo.image.GetHeight() + 96, 10);
spinner.sprite.SetOpacity(0);

bar.bg_image = Image("splash-bar-bg.png");
bar.fill_full = Image("splash-bar-fill.png");
bar.x = X + W / 2 - bar.bg_image.GetWidth() / 2;
bar.y = logo.y + logo.image.GetHeight() + 104;
bar.bg_sprite = Sprite(bar.bg_image);
bar.bg_sprite.SetPosition(bar.x, bar.y, 11);
bar.bg_sprite.SetOpacity(0);
bar.fill_sprite = Sprite(bar.fill_full.Scale(1, bar.fill_full.GetHeight()));
bar.fill_sprite.SetPosition(bar.x, bar.y, 12);
bar.fill_sprite.SetOpacity(0);

state.tick = 0;
state.is_update = (Plymouth.GetMode() == "updates" || Plymouth.GetMode() == "system-upgrade");
state.progress = 0;

fun set_update_progress (pct)
  {
    state.is_update = 1;
    if (pct < 0)
      pct = 0;
    if (pct > 100)
      pct = 100;
    state.progress = pct;
    w = Math.Int((bar.fill_full.GetWidth() * pct) / 100);
    if (w < 6 && pct > 0)
      w = 6;
    if (w > 0)
      {
        bar.fill_sprite.SetImage(bar.fill_full.Scale(w, bar.fill_full.GetHeight()));
        bar.fill_sprite.SetOpacity(1);
      }
    else
      {
        bar.fill_sprite.SetOpacity(0);
      }
    bar.bg_sprite.SetOpacity(1);
    spinner.sprite.SetOpacity(0);
  }

fun refresh_callback ()
  {
    state.tick++;
    fade = state.tick / 30;
    if (fade > 1)
      fade = 1;
    logo.sprite.SetOpacity(fade);
    name.sprite.SetOpacity(fade);
    vendor.sprite.SetOpacity(fade * 0.9);
    if (state.is_update)
      {
        spinner.sprite.SetOpacity(0);
        bar.bg_sprite.SetOpacity(fade);
        if (state.progress > 0)
          bar.fill_sprite.SetOpacity(fade);
      }
    else
      {
        bar.bg_sprite.SetOpacity(0);
        bar.fill_sprite.SetOpacity(0);
        spinner.sprite.SetOpacity(fade);
        frame = Math.Int(state.tick / 4) % 12;
        spinner.sprite.SetImage(spin[frame]);
      }
  }

Plymouth.SetRefreshFunction (refresh_callback);
Plymouth.SetSystemUpdateFunction (set_update_progress);
