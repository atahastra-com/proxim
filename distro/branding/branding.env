# Single source of the visible OS name, vendor and logo.
# Read by distro/apply-branding.sh (host side) and installed as
# /usr/share/kos/branding.env for /usr/libexec/kos-whitelabel (in the image).
# Internal ids (kos-shell@kos, ~/.config/kos, build.sh) are not branding.
OS_NAME="Proxim OS"
OS_VERSION="0.1"
OS_ID="proxim"
OS_VENDOR="Atahastra"
OS_HOSTNAME="proxim"
OS_LOGO="proxim-logo"
PLYMOUTH_THEME="proxim"
