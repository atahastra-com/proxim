[Desktop Entry]
Type=Application
Name=Package Installer
Comment=Install downloaded .deb packages
Exec=/usr/bin/kos-deb-installer %f
Icon=proxim-logo
Terminal=false
NoDisplay=true
StartupNotify=true
MimeType=application/vnd.debian.binary-package;application/x-deb;application/x-debian-package;
Categories=System;PackageManager;
