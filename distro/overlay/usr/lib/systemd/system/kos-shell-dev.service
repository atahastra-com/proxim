[Unit]
Description=Bind-mount the host kos-shell extension over the installed copy
After=mnt-kosdev.mount
Requires=mnt-kosdev.mount
ConditionPathExists=/mnt/kosdev/metadata.json

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/mount --bind /mnt/kosdev /usr/share/gnome-shell/extensions/kos-shell@kos
ExecStop=/bin/umount /usr/share/gnome-shell/extensions/kos-shell@kos

[Install]
WantedBy=multi-user.target
