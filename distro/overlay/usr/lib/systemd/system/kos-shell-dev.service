[Unit]
Description=Bind-mount the host kos-shell extension over the installed copy
After=systemd-modules-load.service mnt-kosdev.mount
Wants=mnt-kosdev.mount
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/kos-mount-dev
ExecStop=-/bin/umount /usr/share/gnome-shell/extensions/kos-shell@kos

[Install]
WantedBy=multi-user.target
