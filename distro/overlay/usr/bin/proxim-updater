#!/usr/bin/env python3
"""Apple-style GTK4/libadwaita Software Update manager for Proxim OS."""

import base64
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import threading
import urllib.error
import urllib.parse
import urllib.request

import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Adw, Gio, GLib, Gtk


def parse_kv_file(path):
    data = {}
    if not os.path.isfile(path):
        return data
    try:
        with open(path, encoding='utf-8') as fh:
            for raw in fh:
                line = raw.strip()
                if not line or line.startswith('#') or '=' not in line:
                    continue
                k, v = line.split('=', 1)
                data[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return data


def get_os_info():
    osr = parse_kv_file('/etc/os-release')
    return {
        'name': osr.get('NAME', 'Proxim OS'),
        'version': osr.get('VERSION_ID') or osr.get('VERSION') or '0.1',
        'pretty': osr.get('PRETTY_NAME', 'Proxim OS 0.1'),
        'vendor': osr.get('VENDOR_NAME', 'Atahastra'),
        'logo': osr.get('LOGO', 'proxim-logo'),
    }


def get_update_config():
    cfg = {
        'UPDATE_URL': 'https://updates.atahastra.com/proxim-os/latest.json',
        'CHANNEL': 'stable',
        'PUBLIC_KEY': '/etc/kos/update-signing.pub',
    }
    for p in (
        '/etc/kos/update.conf',
        '/etc/kos/update.local.conf',
        os.path.expanduser('~/.config/kos/update.conf'),
    ):
        cfg.update(parse_kv_file(p))
    return cfg


def version_key(ver_str):
    parts = re.findall(r'\d+|[a-zA-Z]+', str(ver_str))
    out = []
    for p in parts:
        if p.isdigit():
            out.append((0, int(p)))
        else:
            out.append((1, p.lower()))
    return tuple(out)


def is_newer(candidate, current):
    return version_key(candidate) > version_key(current)


def format_bytes(num):
    try:
        n = float(num)
    except (TypeError, ValueError):
        return ''
    if n <= 0:
        return ''
    for unit in ('B', 'KB', 'MB', 'GB'):
        if n < 1024 or unit == 'GB':
            return f'{n:.1f} {unit}' if unit != 'B' else f'{int(n)} B'
        n /= 1024
    return ''


def read_bundle_manifest(bundle_path):
    with tarfile.open(bundle_path, 'r:gz') as tf:
        for name in ('manifest.json', './manifest.json'):
            try:
                member = tf.getmember(name)
                fh = tf.extractfile(member)
                if fh:
                    data = json.loads(fh.read().decode('utf-8'))
                    data['_local_bundle'] = os.path.abspath(bundle_path)
                    data.setdefault('size_bytes', os.path.getsize(bundle_path))
                    return data
            except KeyError:
                continue
    raise ValueError('Bundle does not contain a valid manifest.json')


class SoftwareUpdateWindow(Adw.ApplicationWindow):
    def __init__(self, app, initial_bundle=None):
        super().__init__(application=app, title='Software Update')
        self.set_default_size(560, 480)
        self.os_info = get_os_info()
        self.cfg = get_update_config()
        self.available = None
        self._busy = False

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()

        open_btn = Gtk.Button(icon_name='document-open-symbolic')
        open_btn.set_tooltip_text('Install Update File (.pxu)…')
        open_btn.connect('clicked', self._on_choose_bundle)
        header.pack_start(open_btn)

        self.refresh_btn = Gtk.Button(icon_name='view-refresh-symbolic')
        self.refresh_btn.set_tooltip_text('Check for Updates')
        self.refresh_btn.connect('clicked', lambda _b: self.check_for_updates())
        header.pack_end(self.refresh_btn)

        toolbar.add_top_bar(header)

        scroll = Gtk.ScrolledWindow(vexpand=True)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        clamp = Adw.Clamp(maximum_size=520)
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        main_box.set_margin_top(20)
        main_box.set_margin_bottom(24)
        main_box.set_margin_start(20)
        main_box.set_margin_end(20)

        # Hero OS identity card (Apple Software Update style)
        hero = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        logo = Gtk.Image.new_from_icon_name(self.os_info['logo'])
        logo.set_pixel_size(64)
        hero.append(logo)

        hero_text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        hero_text.set_valign(Gtk.Align.CENTER)
        hero_text.set_hexpand(True)

        title_lbl = Gtk.Label(label=self.os_info['pretty'], xalign=0)
        title_lbl.add_css_class('title-1')
        hero_text.append(title_lbl)

        vendor_lbl = Gtk.Label(
            label=f"{self.os_info['vendor']}  •  Channel: {self.cfg.get('CHANNEL', 'stable')}",
            xalign=0,
        )
        vendor_lbl.add_css_class('dim-label')
        hero_text.append(vendor_lbl)

        self.state_lbl = Gtk.Label(label='Checking for updates…', xalign=0, wrap=True)
        hero_text.append(self.state_lbl)

        self.spinner = Gtk.Spinner()
        self.spinner.set_valign(Gtk.Align.CENTER)
        hero.append(hero_text)
        hero.append(self.spinner)
        main_box.append(hero)

        # Last offline update banner (if any)
        self.banner_group = Adw.PreferencesGroup()
        self.banner_row = Adw.ActionRow()
        self.banner_group.add(self.banner_row)
        self.banner_group.set_visible(False)
        main_box.append(self.banner_group)

        # Update details & Release Notes group
        self.update_group = Adw.PreferencesGroup(title='Available Update')
        self.update_group.set_visible(False)
        self.update_header_row = Adw.ActionRow()
        self.update_group.add(self.update_header_row)
        main_box.append(self.update_group)

        # Download / staging progress & primary action (above release notes)
        self.progress_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.progress_box.set_visible(False)
        self.progress_bar = Gtk.ProgressBar(show_text=True)
        self.progress_box.append(self.progress_bar)
        main_box.append(self.progress_box)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_row.set_halign(Gtk.Align.START)

        self.action_btn = Gtk.Button(label='Download & Install')
        self.action_btn.add_css_class('suggested-action')
        self.action_btn.add_css_class('pill')
        self.action_btn.set_visible(False)
        self.action_btn.connect('clicked', self._on_primary_action)
        btn_row.append(self.action_btn)

        self.cancel_staged_btn = Gtk.Button(label='Cancel')
        self.cancel_staged_btn.add_css_class('pill')
        self.cancel_staged_btn.set_visible(False)
        self.cancel_staged_btn.connect('clicked', self._on_cancel_staged)
        btn_row.append(self.cancel_staged_btn)

        main_box.append(btn_row)

        # Release notes as simple bullet list (no boxed rows)
        self.notes_group = Adw.PreferencesGroup(title="What's New")
        self.notes_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.notes_box.set_margin_top(4)
        self.notes_box.set_margin_bottom(8)
        self.notes_box.set_margin_start(4)
        self.notes_box.set_margin_end(4)
        self.notes_group.add(self.notes_box)
        self.notes_group.set_visible(False)
        self._note_rows = []
        main_box.append(self.notes_group)

        clamp.set_child(main_box)
        scroll.set_child(clamp)
        toolbar.set_content(scroll)
        self.set_content(toolbar)

        self._load_last_status()
        if initial_bundle:
            self._load_local_bundle(initial_bundle)
        elif not self._check_pending_staged():
            self.check_for_updates()

    def _load_last_status(self):
        res_path = '/var/lib/kos-update/last-result.json'
        if not os.path.isfile(res_path):
            return
        try:
            with open(res_path, encoding='utf-8') as fh:
                res = json.load(fh)
            msg = res.get('message', '')
            when = res.get('updated_at', '')
            if msg:
                self.banner_row.set_title(msg)
                self.banner_row.set_subtitle(f'Last update run: {when}' if when else '')
                self.banner_group.set_visible(True)
        except Exception:
            pass

    def _check_pending_staged(self):
        if not os.path.islink('/system-update'):
            self.cancel_staged_btn.set_visible(False)
            return False
        ver = ''
        try:
            with open('/var/lib/kos-update/pending.json', encoding='utf-8') as fh:
                meta = json.load(fh)
                ver = meta.get('version', '')
                self._populate_update_view(meta)
        except Exception:
            pass
        self.state_lbl.set_text(
            f'Proxim OS {ver} is staged and ready to install on restart.'
            if ver else 'An update is staged and ready to install on restart.'
        )
        self.cancel_staged_btn.set_visible(True)
        self.action_btn.set_label('Restart Now')
        self.action_btn.set_visible(True)
        self.available = {'_staged': True}
        return True

    def _clear_notes(self):
        for r in self._note_rows:
            self.notes_box.remove(r)
        self._note_rows.clear()

    def _populate_update_view(self, manifest):
        ver = str(manifest.get('version', ''))
        name = manifest.get('name') or f"{self.os_info['name']} {ver}"
        released = manifest.get('released', '')
        size_str = format_bytes(manifest.get('size_bytes'))
        sub_parts = [p for p in (f'Version {ver}', released, size_str) if p]

        self.update_header_row.set_title(name)
        self.update_header_row.set_subtitle('  •  '.join(sub_parts))
        self.update_group.set_visible(True)

        self._clear_notes()
        notes = manifest.get('notes') or []
        if isinstance(notes, str):
            notes = [l.strip() for l in notes.splitlines() if l.strip()]
        if notes:
            for item in notes:
                lbl = Gtk.Label(label=f'•  {item}', xalign=0, wrap=True)
                self.notes_box.append(lbl)
                self._note_rows.append(lbl)
            self.notes_group.set_visible(True)
        else:
            self.notes_group.set_visible(False)

    def check_for_updates(self):
        if self._busy:
            return
        self._busy = True
        self.refresh_btn.set_sensitive(False)
        self.action_btn.set_visible(False)
        self.progress_box.set_visible(False)
        self.spinner.start()
        self.state_lbl.set_text('Checking for updates…')
        url = self.cfg.get('UPDATE_URL', '').strip()

        def worker():
            manifest = None
            err_msg = None
            try:
                req = urllib.request.Request(
                    url,
                    headers={'User-Agent': f"ProximOS-Updater/{self.os_info['version']}"},
                )
                with urllib.request.urlopen(req, timeout=8) as resp:
                    manifest = json.loads(resp.read().decode('utf-8'))
            except urllib.error.URLError as exc:
                err_msg = str(getattr(exc, 'reason', exc))
            except Exception as exc:
                err_msg = str(exc)

            def finish():
                self._busy = False
                self.refresh_btn.set_sensitive(True)
                self.spinner.stop()
                if err_msg or not isinstance(manifest, dict):
                    self.update_group.set_visible(False)
                    self.notes_group.set_visible(False)
                    self.state_lbl.set_text(
                        f"{self.os_info['pretty']} is installed.\n"
                        "Could not reach the update server — check your connection or use the top-left button to install a .pxu update file."
                    )
                    return False

                remote_ver = str(manifest.get('version', '')).strip()
                if not remote_ver or not is_newer(remote_ver, self.os_info['version']):
                    self.available = None
                    self.update_group.set_visible(False)
                    self.notes_group.set_visible(False)
                    self.state_lbl.set_text(f"{self.os_info['name']} is up to date.")
                    return False

                self.available = manifest
                self._populate_update_view(manifest)
                self.state_lbl.set_text(f"A new {self.os_info['name']} update is available.")
                self.action_btn.set_label('Download & Install')
                self.action_btn.set_sensitive(True)
                self.action_btn.set_visible(True)
                return False

            GLib.idle_add(finish)

        threading.Thread(target=worker, daemon=True).start()

    def _on_choose_bundle(self, _btn):
        if self._busy:
            return
        dialog = Gtk.FileDialog(title='Select Proxim OS Update Bundle (.pxu)')
        flt = Gtk.FileFilter()
        flt.set_name('Proxim OS Update (*.pxu)')
        flt.add_pattern('*.pxu')
        store = Gio.ListStore.new(Gtk.FileFilter)
        store.append(flt)
        dialog.set_filters(store)

        def on_done(dlg, res):
            try:
                gf = dlg.open_finish(res)
                if gf and gf.get_path():
                    self._load_local_bundle(gf.get_path())
            except GLib.Error:
                pass

        dialog.open(self, None, on_done)

    def _load_local_bundle(self, path):
        try:
            manifest = read_bundle_manifest(path)
        except Exception as exc:
            self.state_lbl.set_text(f'Invalid update bundle: {exc}')
            return
        self.available = manifest
        self._populate_update_view(manifest)
        ver = manifest.get('version', '')
        self.state_lbl.set_text(f'Ready to install {self.os_info["name"]} {ver} on restart.')
        self.action_btn.set_label('Install & Restart')
        self.action_btn.set_sensitive(True)
        self.action_btn.set_visible(True)

    def _on_cancel_staged(self, _btn):
        subprocess.run(['pkexec', '/usr/libexec/kos-update-helper', 'cancel'], check=False)
        self.available = None
        self.cancel_staged_btn.set_visible(False)
        self.action_btn.set_visible(False)
        self.update_group.set_visible(False)
        self.notes_group.set_visible(False)
        self.state_lbl.set_text(f"{self.os_info['name']} is up to date.")

    def _on_primary_action(self, _btn):
        if self._busy or not self.available:
            return
        if self.available.get('_staged'):
            subprocess.Popen(['systemctl', 'reboot'])
            return
        local_bundle = self.available.get('_local_bundle')
        if local_bundle and os.path.isfile(local_bundle):
            sig_path = local_bundle + '.sig' if os.path.isfile(local_bundle + '.sig') else ''
            self._stage_and_confirm_reboot(local_bundle, sig_path)
            return
        self._download_and_stage(self.available)

    def _download_and_stage(self, manifest):
        raw_url = manifest.get('url', '').strip()
        if not raw_url:
            self.state_lbl.set_text('Update manifest is missing download URL.')
            return
        bundle_url = urllib.parse.urljoin(self.cfg.get('UPDATE_URL', ''), raw_url)
        expected_sha = manifest.get('sha256', '').strip().lower()
        sig_b64 = manifest.get('signature', '').strip()
        ver = manifest.get('version', 'next')

        self._busy = True
        self.action_btn.set_sensitive(False)
        self.refresh_btn.set_sensitive(False)
        self.progress_bar.set_fraction(0.0)
        self.progress_bar.set_text('Starting download…')
        self.progress_box.set_visible(True)

        cache_dir = os.path.expanduser('~/.cache/kos/updates')
        os.makedirs(cache_dir, exist_ok=True)
        dest_path = os.path.join(cache_dir, f'proxim-os-{ver}.pxu')
        sig_path = dest_path + '.sig'

        def worker():
            try:
                req = urllib.request.Request(
                    bundle_url,
                    headers={'User-Agent': f"ProximOS-Updater/{self.os_info['version']}"},
                )
                hasher = hashlib.sha256()
                with urllib.request.urlopen(req, timeout=30) as resp, open(dest_path + '.part', 'wb') as out:
                    total = int(resp.headers.get('Content-Length') or manifest.get('size_bytes') or 0)
                    done = 0
                    while True:
                        chunk = resp.read(65536)
                        if not chunk:
                            break
                        out.write(chunk)
                        hasher.update(chunk)
                        done += len(chunk)
                        if total > 0:
                            frac = min(1.0, done / total)
                            txt = f'Downloading… {format_bytes(done)} / {format_bytes(total)} ({int(frac * 100)}%)'
                            GLib.idle_add(self._update_progress, frac, txt)
                        else:
                            GLib.idle_add(self._update_progress, 0.5, f'Downloading… {format_bytes(done)}')

                got_sha = hasher.hexdigest().lower()
                if expected_sha and got_sha != expected_sha:
                    os.unlink(dest_path + '.part')
                    raise ValueError(f'SHA-256 mismatch (expected {expected_sha[:12]}…, got {got_sha[:12]}…)')
                os.replace(dest_path + '.part', dest_path)

                written_sig = ''
                if sig_b64:
                    with open(sig_path, 'wb') as sf:
                        sf.write(base64.b64decode(sig_b64))
                    written_sig = sig_path
            except Exception as exc:
                def on_err():
                    self._busy = False
                    self.action_btn.set_sensitive(True)
                    self.refresh_btn.set_sensitive(True)
                    self.progress_box.set_visible(False)
                    self.state_lbl.set_text(f'Download failed: {exc}')
                    return False

                GLib.idle_add(on_err)
                return

            def on_downloaded():
                self._busy = False
                self.refresh_btn.set_sensitive(True)
                self.progress_bar.set_fraction(1.0)
                self.progress_bar.set_text('Download verified')
                self._stage_and_confirm_reboot(dest_path, written_sig)
                return False

            GLib.idle_add(on_downloaded)

        threading.Thread(target=worker, daemon=True).start()

    def _update_progress(self, frac, text):
        self.progress_bar.set_fraction(frac)
        self.progress_bar.set_text(text)
        return False

    def _stage_and_confirm_reboot(self, bundle_path, sig_path=''):
        self._busy = True
        self.action_btn.set_sensitive(False)
        self.state_lbl.set_text('Preparing update…')

        def worker():
            cmd = ['pkexec', '/usr/libexec/kos-update-helper', 'stage', bundle_path]
            if sig_path:
                cmd.append(sig_path)
            proc = subprocess.run(cmd, capture_output=True, text=True)

            def finish():
                self._busy = False
                self.action_btn.set_sensitive(True)
                if proc.returncode != 0:
                    if proc.returncode in (126, 127):
                        self.state_lbl.set_text('Authentication cancelled.')
                    else:
                        err = (proc.stderr or proc.stdout or '').strip()
                        self.state_lbl.set_text(f'Could not stage update: {err}')
                    return False

                self._check_pending_staged()
                self._prompt_restart_dialog()
                return False

            GLib.idle_add(finish)

        threading.Thread(target=worker, daemon=True).start()

    def _prompt_restart_dialog(self):
        dlg = Adw.AlertDialog(
            heading='Restart to Finish Updating',
            body='Proxim OS has verified and staged the update. Your computer will restart, apply the update on the boot screen, and start the new version.',
        )
        dlg.add_response('later', 'Tonight / Later')
        dlg.add_response('restart', 'Restart Now')
        dlg.set_response_appearance('restart', Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response('restart')
        dlg.set_close_response('later')
        dlg.connect('response', lambda _d, resp: subprocess.Popen(['systemctl', 'reboot']) if resp == 'restart' else None)
        dlg.present(self)


class SoftwareUpdateApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id='org.proxim.SoftwareUpdate',
            flags=Gio.ApplicationFlags.HANDLES_OPEN,
        )

    def do_activate(self):
        os.environ.pop('LD_PRELOAD', None)
        os.execvp('gnome-control-center', ['gnome-control-center', 'system'])

    def do_open(self, files, _n_files, _hint):
        bundle = None
        for gf in files:
            uri = gf.get_uri() or ''
            if uri.startswith('proxim-update:'):
                continue
            path = gf.get_path()
            if path and os.path.isfile(path):
                bundle = path
                break
        if not bundle:
            os.environ.pop('LD_PRELOAD', None)
            os.execvp('gnome-control-center', ['gnome-control-center', 'system'])
        win = SoftwareUpdateWindow(self, initial_bundle=bundle)
        win.present()


def main():
    app = SoftwareUpdateApp()
    return app.run(sys.argv)


if __name__ == '__main__':
    sys.exit(main())
