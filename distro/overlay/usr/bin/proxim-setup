        hdr.add_css_class('title-2')
        top.append(hdr)

        ref_btn = Gtk.Button.new_from_icon_name('view-refresh-symbolic')
        ref_btn.set_tooltip_text('Refresh Disks')
        ref_btn.connect('clicked', lambda _b: self._refresh_disks())
        top.append(ref_btn)
        box.append(top)

        sub = Gtk.Label(
            label='Select the drive where Proxim OS will be installed. All existing data on the selected drive will be erased.',
            xalign=0,
            wrap=True,
        )
        sub.add_css_class('dim-label')
        box.append(sub)

        self.disk_group = Adw.PreferencesGroup(title='Available Drives')
        self.disk_rows = []
        box.append(self.disk_group)

        self.mode_group = Adw.PreferencesGroup(title='Installation Mode')
        self.erase_chk = Gtk.CheckButton()
        self.erase_chk.set_active(True)
        self.erase_chk.connect('toggled', lambda b: self._on_mode_changed('erase', b))
        erase_row = Adw.ActionRow(
            title='Erase Selected Disk & Install Proxim OS',
            subtitle='Creates GPT EFI + ext4 partitions automatically (recommended)',
