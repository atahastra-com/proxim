        self.net_sub.add_css_class('dim-label')
        box.append(self.net_sub)

        status_group = Adw.PreferencesGroup()
        self.net_status_row = Adw.ActionRow(title='Checking connection…', subtitle='')
        self.net_status_icon = Gtk.Image.new_from_icon_name('network-wireless-symbolic')
        self.net_status_row.add_prefix(self.net_status_icon)
        status_group.add(self.net_status_row)
        box.append(status_group)

        self.wifi_group = Adw.PreferencesGroup(title='Wi-Fi Network')
        self.wifi_ssid_row = Adw.ComboRow(title='Network')
        self.wifi_group.add(self.wifi_ssid_row)
        self.wifi_pass_row = Adw.PasswordEntryRow(title='Wi-Fi Password')
        self.wifi_group.add(self.wifi_pass_row)

        conn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        conn_box.set_margin_top(6)
        self.wifi_err = Gtk.Label(xalign=0, hexpand=True, wrap=True)
        self.wifi_err.add_css_class('dim-label')
        self.wifi_err.add_css_class('caption')
        conn_box.append(self.wifi_err)

        self.wifi_connect_btn = Gtk.Button(label='Connect')
        self.wifi_connect_btn.connect('clicked', self._on_wifi_connect)
        conn_box.append(self.wifi_connect_btn)
        box.append(self.wifi_group)
        box.append(conn_box)
        self._wifi_conn_box = conn_box
        return self._wrap_page(box)

    def _refresh_network(self):
        eth_up = False
        wifi_conn = ''
        ssids = []
        try:
            out = subprocess.check_output(
                ['nmcli', '-t', '-f', 'TYPE,STATE,CONNECTION', 'dev'],
                stderr=subprocess.DEVNULL,
                text=True,
            )
            for ln in out.splitlines():
                parts = ln.split(':', 2)
                if len(parts) == 3 and parts[1] == 'connected':
                    if parts[0] == 'ethernet':
                        eth_up = True
                    elif parts[0] == 'wifi':
                        wifi_conn = parts[2]
        except Exception:
            pass

        if eth_up:
            self.net_status_row.set_title('Connected via Ethernet')
            self.net_status_row.set_subtitle('Ready for online updates — no Wi-Fi setup needed.')
            self.net_status_icon.set_from_icon_name('network-wired-symbolic')
            self.wifi_group.set_visible(False)
            self._wifi_conn_box.set_visible(False)
            return

        if wifi_conn:
            self.net_status_row.set_title(f'Connected to {wifi_conn}')
            self.net_status_row.set_subtitle('Wi-Fi is connected.')
            self.net_status_icon.set_from_icon_name('network-wireless-signal-excellent-symbolic')
        else:
            self.net_status_row.set_title('Not Connected')
            self.net_status_row.set_subtitle('Select a Wi-Fi network below or click Continue to install offline.')
            self.net_status_icon.set_from_icon_name('network-wireless-offline-symbolic')

        self.wifi_group.set_visible(True)
        self._wifi_conn_box.set_visible(True)
        try:
            wout = subprocess.check_output(
                ['nmcli', '-t', '-f', 'SSID', 'dev', 'wifi', 'list', '--rescan', 'auto'],
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=8,
            )
            seen = set()
            for raw in wout.splitlines():
                s = raw.strip()
                if s and s not in seen:
                    seen.add(s)
                    ssids.append(s)
        except Exception:
            pass
        if not ssids:
            ssids = ['No Wi-Fi networks found']
            self.wifi_connect_btn.set_sensitive(False)
        else:
            self.wifi_connect_btn.set_sensitive(True)
        self.wifi_ssid_row.set_model(Gtk.StringList.new(ssids))

    def _on_wifi_connect(self, _btn):
        item = self.wifi_ssid_row.get_selected_item()
        ssid = item.get_string() if item else ''
        if not ssid or ssid == 'No Wi-Fi networks found':
            return
        pw = self.wifi_pass_row.get_text()
        self.wifi_connect_btn.set_sensitive(False)
        self.wifi_err.set_text(f'Connecting to {ssid}…')

        def worker():
            cmd = ['nmcli', 'dev', 'wifi', 'connect', ssid]
            if pw:
                cmd += ['password', pw]
            proc = subprocess.run(cmd, capture_output=True, text=True)

            def done():
                self.wifi_connect_btn.set_sensitive(True)
                if proc.returncode == 0:
                    self.wifi_err.set_text(f'Connected to {ssid}.')
                    self._refresh_network()
                else:
                    msg = (proc.stderr or proc.stdout or 'Connection failed').strip()
                    self.wifi_err.set_text(msg.splitlines()[-1] if msg else 'Connection failed')
                return False

            GLib.idle_add(done)

        threading.Thread(target=worker, daemon=True).start()

    def _build_region_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)

        hdr = Gtk.Label(label='Time Zone & Privacy', xalign=0)
        hdr.add_css_class('title-2')
        box.append(hdr)

        sub = Gtk.Label(
            label='Choose your time zone so your clock and calendar stay accurate.',
            xalign=0,
            wrap=True,
        )
        sub.add_css_class('dim-label')
        box.append(sub)

        group = Adw.PreferencesGroup()
        self.tz_row = Adw.ComboRow(title='Time Zone')
        self.tz_row.set_model(Gtk.StringList.new(self._zones))
        cur = current_timezone()
        if cur in self._zones:
            self.tz_row.set_selected(self._zones.index(cur))
        self.tz_row.connect('notify::selected', self._on_tz_changed)
        group.add(self.tz_row)

        self.auto_tz_row = Adw.ActionRow(
            title='Automatic Date & Time',
            subtitle='Time syncs via internet (NTP); time zone auto-detected from IP when online',
        )
        self.auto_tz_row.add_prefix(Gtk.Image.new_from_icon_name('preferences-system-time-symbolic'))
        group.add(self.auto_tz_row)
        box.append(group)

        priv_group = Adw.PreferencesGroup(title='System Updates & Privacy')
        self.updates_switch = Adw.SwitchRow(
            title='Download & install system updates',
            subtitle='Fetch latest security and OS updates during installation (when online)',
        )
        self.updates_switch.set_active(True)
        priv_group.add(self.updates_switch)

        priv_row = Adw.ActionRow(
            title='No Telemetry or Tracking',
            subtitle='Proxim OS never collects diagnostic data or usage analytics.',
        )
        priv_row.add_prefix(Gtk.Image.new_from_icon_name('security-high-symbolic'))
        priv_group.add(priv_row)
        box.append(priv_group)
        return self._wrap_page(box)

