def detect_timezones():
    try:
        out = subprocess.check_output(
            ['timedatectl', 'list-timezones'],
            stderr=subprocess.DEVNULL,
            text=True,
        )
        zones = [z.strip() for z in out.splitlines() if z.strip()]
        if zones:
            return zones
    except Exception:
        pass
    return [
        'UTC',
        'Asia/Kolkata',
        'America/New_York',
        'America/Los_Angeles',
        'Europe/London',
        'Europe/Berlin',
        'Asia/Tokyo',
        'Australia/Sydney',
    ]


def current_timezone():
    try:
        return subprocess.check_output(
            ['timedatectl', 'show', '-p', 'Timezone', '--value'],
            stderr=subprocess.DEVNULL,
            text=True,
        ).strip() or 'UTC'
    except Exception:
        return 'UTC'


def detect_ip_timezone():
    """Best-effort IP-based timezone lookup when online."""
    for url in (
        'https://ipapi.co/timezone',
        'http://ip-api.com/line/?fields=timezone',
    ):
        try:
            req = urllib.request.Request(url, headers={'User-Agent': 'ProximOS-Installer/1'})
            with urllib.request.urlopen(req, timeout=3.5) as resp:
                tz = resp.read().decode('utf-8').strip()
                if tz and '/' in tz and ' ' not in tz:
                    return tz
        except Exception:
            continue
    return None


def fmt_bytes(n):
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if n < 1000.0 or unit == 'TB':
            return f'{n:.1f} {unit}' if unit != 'B' else f'{int(n)} B'
        n /= 1000.0
    return f'{n:.1f} TB'


def detect_install_disks():
    """Return (disks, partitions) excluding the live USB medium.

    disks: [(dev_path, title, subtitle)]
    partitions: [(part_path, label, disk_path, is_efi)]
    """
    live_disk = ''
    try:
        src = subprocess.check_output(
            ['findmnt', '-n', '-o', 'SOURCE', '/run/live/medium'],
            stderr=subprocess.DEVNULL,
            text=True,
        ).strip()
        if src:
            pk = subprocess.check_output(
                ['lsblk', '-no', 'PKNAME', src],
                stderr=subprocess.DEVNULL,
                text=True,
            ).strip()
            live_disk = pk or os.path.basename(src)
    except Exception:
        pass

    disks = []
    partitions = []
    try:
        raw = subprocess.check_output(
            ['lsblk', '-J', '-b', '-o', 'NAME,SIZE,MODEL,TRAN,RM,TYPE,FSTYPE,LABEL,PARTLABEL'],
            stderr=subprocess.DEVNULL,
            text=True,
        )
        data = json.loads(raw)
        for dev in data.get('blockdevices', []):
            if dev.get('type') != 'disk':
                continue
            name = dev.get('name', '')
            if not name or name == live_disk or name.startswith(('loop', 'ram', 'zram', 'sr')):
                continue
            size = int(dev.get('size') or 0)
            if size < 4 * 1000 * 1000 * 1000:
                continue
            model = (dev.get('model') or 'Internal Disk').strip()
            tran = (dev.get('tran') or '').upper()
            part_summaries = []
            for ch in dev.get('children') or []:
                if ch.get('type') != 'part':
                    continue
                pname = ch.get('name', '')
                psize = int(ch.get('size') or 0)
                fstype = (ch.get('fstype') or 'unformatted').lower()
                plabel = (ch.get('label') or ch.get('partlabel') or '').strip()
                is_efi = fstype in ('vfat', 'fat32') and psize <= 1024 * 1024 * 1024
                tag = f'{plabel} ({fstype}, {fmt_bytes(psize)})' if plabel else f'{fstype} ({fmt_bytes(psize)})'
                part_summaries.append(tag)
                partitions.append((
                    f'/dev/{pname}',
                    f'/dev/{pname} — {tag}',
                    f'/dev/{name}',
                    is_efi,
                ))
            title = f'{model} ({fmt_bytes(size)})'
            sub = f'/dev/{name}' + (f'  •  {tran}' if tran else '')
            if part_summaries:
                sub += '\nPartitions: ' + ', '.join(part_summaries[:4])
                if len(part_summaries) > 4:
                    sub += f' (+{len(part_summaries) - 4} more)'
            else:
                sub += '\nUnpartitioned / Empty Drive'
            disks.append((f'/dev/{name}', title, sub))
    except Exception:
        pass
    return disks, partitions


class InstallerWindow(Adw.ApplicationWindow):
    """Complete 7-step OS Installation & Account Setup Wizard for USB Live Boot."""

    def __init__(self, app, preview=False):
        super().__init__(application=app, title='Install Proxim OS')
        self.preview = preview
        self.set_default_size(680, 590)
        self.set_resizable(False)
        if not preview:
            self.set_deletable(False)
        self._page = 0
        self._username_edited = False
        self._tz_edited = False
        self._zones = detect_timezones()
        self._disks = []
        self._partitions = []
        self._selected_disk = None
        self._install_mode = 'erase'
        self._installing = False

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_show_title(False)
        badge = Gtk.Label(label='Preview Mode' if preview else 'Proxim OS Installer')
        badge.add_css_class('dim-label')
        badge.add_css_class('caption')
        header.pack_start(badge)
        toolbar.add_top_bar(header)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.carousel = Adw.Carousel(allow_mouse_drag=False, allow_scroll_wheel=False)
        self.carousel.set_vexpand(True)
        self.carousel.set_hexpand(True)

        self.carousel.append(self._build_welcome_page())   # 0
        self.carousel.append(self._build_network_page())   # 1
        self.carousel.append(self._build_region_page())    # 2
        self.carousel.append(self._build_account_page())   # 3
        self.carousel.append(self._build_disk_page())      # 4
        self.carousel.append(self._build_summary_page())   # 5
        self.carousel.append(self._build_progress_page())  # 6
        self.carousel.append(self._build_done_page())      # 7
        root.append(self.carousel)

        dots = Adw.CarouselIndicatorDots(carousel=self.carousel)
        dots.set_margin_bottom(8)
        root.append(dots)

        self.nav_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.nav_bar.set_margin_start(32)
        self.nav_bar.set_margin_end(32)
        self.nav_bar.set_margin_bottom(24)

        self.back_btn = Gtk.Button(label='Back')
        self.back_btn.set_visible(False)
        self.back_btn.connect('clicked', self._on_back)
        self.nav_bar.append(self.back_btn)

        self.nav_bar.append(Gtk.Box(hexpand=True))

        self.try_btn = Gtk.Button(label='Try Proxim OS')
        self.try_btn.connect('clicked', self._on_try_live)
        self.nav_bar.append(self.try_btn)

        self.next_btn = Gtk.Button(label='Install Proxim OS')
        self.next_btn.add_css_class('suggested-action')
        self.next_btn.connect('clicked', self._on_next)
        self.nav_bar.append(self.next_btn)

        root.append(self.nav_bar)
        toolbar.set_content(root)
        self.set_content(toolbar)
        self._refresh_disks()

    def _wrap_page(self, child):
        clamp = Adw.Clamp(maximum_size=500)
        clamp.set_margin_top(10)
        clamp.set_margin_bottom(14)
        clamp.set_margin_start(28)
        clamp.set_margin_end(28)
        clamp.set_valign(Gtk.Align.CENTER)
        clamp.set_child(child)
        return clamp

    def _build_welcome_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_halign(Gtk.Align.CENTER)

        logo = Gtk.Image.new_from_icon_name('proxim-logo')
        logo.set_pixel_size(96)
        logo.set_margin_bottom(8)
        box.append(logo)

        title = Gtk.Label(label='Welcome to Proxim OS')
        title.add_css_class('title-1')
        box.append(title)

        sub = Gtk.Label(
            label='Designed by Atahastra.\nTry Proxim OS live from your USB drive, or install it onto your computer.',
            justify=Gtk.Justification.CENTER,
            wrap=True,
        )
        sub.add_css_class('dim-label')
        box.append(sub)
        return self._wrap_page(box)

    def _build_network_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        hdr = Gtk.Label(label='Connect to Internet', xalign=0, hexpand=True)
        hdr.add_css_class('title-2')
        top.append(hdr)

        ref_btn = Gtk.Button.new_from_icon_name('view-refresh-symbolic')
