#!/usr/bin/env python3
"""Apple-style GTK4/libadwaita First-Boot User Setup Assistant for Proxim OS."""

import json
import os
import re
import subprocess
import sys
import threading

import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Adw, Gio, GLib, Gtk


def detect_timezones():
    try:
        out = subprocess.check_output(
            ['timedatectl', 'list-timezones'],
            stderr=subprocess.DEVNULL,
            text=True,
        )
        zones = [z.strip() for z in out.splitlines() if z.strip()]
        if zones:
            return zones
    except Exception:
        pass
    return [
        'UTC',
        'Asia/Kolkata',
        'America/New_York',
        'America/Los_Angeles',
        'Europe/London',
        'Europe/Berlin',
        'Asia/Tokyo',
        'Australia/Sydney',
    ]


def current_timezone():
    try:
        return subprocess.check_output(
            ['timedatectl', 'show', '-p', 'Timezone', '--value'],
            stderr=subprocess.DEVNULL,
            text=True,
        ).strip() or 'UTC'
    except Exception:
        return 'UTC'


class SetupWindow(Adw.ApplicationWindow):
    def __init__(self, app, preview=False):
        super().__init__(application=app, title='Proxim OS Setup')
        self.preview = preview
        self.set_default_size(640, 560)
        self.set_resizable(False)
        if not preview:
            self.set_deletable(False)

        self._page = 0
        self._username_edited = False
        self._zones = detect_timezones()

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_show_title(False)
        if preview:
            badge = Gtk.Label(label='Preview Mode')
            badge.add_css_class('dim-label')
            badge.add_css_class('caption')
            header.pack_start(badge)
        toolbar.add_top_bar(header)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        self.carousel = Adw.Carousel(allow_mouse_drag=False, allow_scroll_wheel=False)
        self.carousel.set_vexpand(True)
        self.carousel.set_hexpand(True)

        self.carousel.append(self._build_welcome_page())
        self.carousel.append(self._build_account_page())
        self.carousel.append(self._build_region_page())
        self.carousel.append(self._build_finish_page())
        root.append(self.carousel)

        dots = Adw.CarouselIndicatorDots(carousel=self.carousel)
        dots.set_margin_bottom(8)
        root.append(dots)

        nav_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        nav_bar.set_margin_start(32)
        nav_bar.set_margin_end(32)
        nav_bar.set_margin_bottom(24)

        self.back_btn = Gtk.Button(label='Back')
        self.back_btn.set_visible(False)
        self.back_btn.connect('clicked', self._on_back)
        nav_bar.append(self.back_btn)

        spacer = Gtk.Box(hexpand=True)
        nav_bar.append(spacer)

        self.next_btn = Gtk.Button(label='Get Started')
        self.next_btn.add_css_class('suggested-action')
        self.next_btn.connect('clicked', self._on_next)
        nav_bar.append(self.next_btn)

        root.append(nav_bar)
        toolbar.set_content(root)
        self.set_content(toolbar)

    def _wrap_page(self, child):
        clamp = Adw.Clamp(maximum_size=460)
        clamp.set_margin_top(12)
        clamp.set_margin_bottom(16)
        clamp.set_margin_start(28)
        clamp.set_margin_end(28)
        clamp.set_valign(Gtk.Align.CENTER)
        clamp.set_child(child)
        return clamp

    def _build_welcome_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_halign(Gtk.Align.CENTER)

        logo = Gtk.Image.new_from_icon_name('proxim-logo')
        logo.set_pixel_size(96)
        logo.set_margin_bottom(8)
        box.append(logo)

        title = Gtk.Label(label='Welcome to Proxim OS')
        title.add_css_class('title-1')
        box.append(title)

        sub = Gtk.Label(
            label='Designed by Atahastra.\nSet up your personal account and preferences in a few quick steps.',
            justify=Gtk.Justification.CENTER,
            wrap=True,
        )
        sub.add_css_class('dim-label')
        box.append(sub)

        return self._wrap_page(box)

    def _build_account_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)

        hdr = Gtk.Label(label='Create Your Account', xalign=0)
        hdr.add_css_class('title-2')
        box.append(hdr)

        sub = Gtk.Label(
            label='Your account name and password keep your files and system updates secure.',
            xalign=0,
            wrap=True,
        )
        sub.add_css_class('dim-label')
        box.append(sub)

        group = Adw.PreferencesGroup()

        self.full_name_row = Adw.EntryRow(title='Full Name')
        self.full_name_row.connect('changed', self._on_fullname_changed)
        group.add(self.full_name_row)

        self.username_row = Adw.EntryRow(title='Account Name (username)')
        self.username_row.connect('changed', self._on_username_changed)
        group.add(self.username_row)

        self.pass_row = Adw.PasswordEntryRow(title='Password')
        self.pass_row.connect('changed', lambda _r: self._validate_account())
        group.add(self.pass_row)

        self.confirm_row = Adw.PasswordEntryRow(title='Confirm Password')
        self.confirm_row.connect('changed', lambda _r: self._validate_account())
        group.add(self.confirm_row)

        self.host_row = Adw.EntryRow(title='Computer Name')
        self.host_row.set_text('proxim')
        self.host_row.connect('changed', lambda _r: self._validate_account())
        group.add(self.host_row)

        box.append(group)

        self.autologin_switch = Adw.SwitchRow(
            title='Sign in automatically',
            subtitle='Skip the lock screen password on startup',
        )
        opt_group = Adw.PreferencesGroup()
        opt_group.add(self.autologin_switch)
        box.append(opt_group)

        self.account_err = Gtk.Label(xalign=0, wrap=True)
        self.account_err.add_css_class('error')
        self.account_err.add_css_class('caption')
        box.append(self.account_err)

        return self._wrap_page(box)

    def _build_region_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)

        hdr = Gtk.Label(label='Time Zone & Privacy', xalign=0)
        hdr.add_css_class('title-2')
        box.append(hdr)

        sub = Gtk.Label(
            label='Choose your time zone so your clock and calendar stay accurate.',
            xalign=0,
            wrap=True,
        )
        sub.add_css_class('dim-label')
        box.append(sub)

        group = Adw.PreferencesGroup()
        self.tz_row = Adw.ComboRow(title='Time Zone')
        model = Gtk.StringList.new(self._zones)
        self.tz_row.set_model(model)
        cur = current_timezone()
        if cur in self._zones:
            self.tz_row.set_selected(self._zones.index(cur))
        group.add(self.tz_row)
        box.append(group)

        priv_group = Adw.PreferencesGroup(title='Privacy')
        priv_row = Adw.ActionRow(
            title='No Telemetry or Tracking',
            subtitle='Proxim OS never collects diagnostic data or usage analytics.',
        )
        priv_row.add_prefix(Gtk.Image.new_from_icon_name('security-high-symbolic'))
        priv_group.add(priv_row)
        box.append(priv_group)

        return self._wrap_page(box)

    def _build_finish_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_halign(Gtk.Align.CENTER)

        self.done_icon = Gtk.Image.new_from_icon_name('emblem-ok-symbolic')
        self.done_icon.set_pixel_size(64)
        self.done_icon.add_css_class('accent')
        box.append(self.done_icon)

        self.done_title = Gtk.Label(label="You're Ready to Go")
        self.done_title.add_css_class('title-1')
        box.append(self.done_title)

        self.done_sub = Gtk.Label(
            label='Click Finish Setup to create your Proxim OS account and open your desktop.',
            justify=Gtk.Justification.CENTER,
            wrap=True,
        )
        self.done_sub.add_css_class('dim-label')
        box.append(self.done_sub)

        self.done_spinner = Gtk.Spinner()
        self.done_spinner.set_visible(False)
        box.append(self.done_spinner)

        return self._wrap_page(box)

    def _on_fullname_changed(self, row):
        if not self._username_edited:
            raw = row.get_text().strip().lower()
            slug = re.sub(r'[^a-z0-9_-]+', '', raw.split()[0] if raw else '')
            self.username_row.set_text(slug[:24])
        self._validate_account()

    def _on_username_changed(self, row):
        if row.has_focus():
            self._username_edited = True
        self._validate_account()

    def _validate_account(self):
        if self._page != 1:
            return True
        user = self.username_row.get_text().strip().lower()
        p1 = self.pass_row.get_text()
        p2 = self.confirm_row.get_text()
        host = self.host_row.get_text().strip().lower()
        err = ''
        if not user:
            err = 'Enter an account name.'
        elif not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', user):
            err = 'Account name must start with a letter and use lowercase letters, numbers, - or _.'
        elif not p1:
            err = 'Enter a password.'
        elif p1 != p2:
            err = 'Passwords do not match.'
        elif host and not re.fullmatch(r'[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?', host):
            err = 'Computer name can only contain lowercase letters, numbers, and hyphens.'
        self.account_err.set_text(err)
        ok = (err == '')
        self.next_btn.set_sensitive(ok)
        return ok

    def _go_to(self, idx):
        self._page = idx
        self.carousel.scroll_to(self.carousel.get_nth_page(idx), True)
        self.back_btn.set_visible(idx > 0)
        if idx == 0:
            self.next_btn.set_label('Get Started')
            self.next_btn.set_sensitive(True)
        elif idx == 1:
            self.next_btn.set_label('Continue')
            self._validate_account()
        elif idx == 2:
            self.next_btn.set_label('Continue')
            self.next_btn.set_sensitive(True)
        else:
            self.next_btn.set_label('Close Preview' if self.preview else 'Finish Setup')
            self.next_btn.set_sensitive(True)

    def _on_back(self, _btn):
        if self._page > 0:
            self._go_to(self._page - 1)

    def _on_next(self, _btn):
        if self._page == 1 and not self._validate_account():
            return
        if self._page < 3:
            self._go_to(self._page + 1)
            return
        if self.preview:
            self.close()
            return
        self._apply_setup()

    def _apply_setup(self):
        self.back_btn.set_sensitive(False)
        self.next_btn.set_sensitive(False)
        self.done_spinner.set_visible(True)
        self.done_spinner.start()
        self.done_sub.set_text('Configuring your Proxim OS account…')

        tz_item = self.tz_row.get_selected_item()
        payload = {
            'full_name': self.full_name_row.get_text().strip(),
            'username': self.username_row.get_text().strip().lower(),
            'password': self.pass_row.get_text(),
            'hostname': self.host_row.get_text().strip().lower(),
            'timezone': tz_item.get_string() if tz_item else 'UTC',
            'autologin': self.autologin_switch.get_active(),
        }

        def worker():
            proc = subprocess.run(
                ['pkexec', '/usr/libexec/kos-setup-helper'],
                input=json.dumps(payload),
                capture_output=True,
                text=True,
            )

            def finish():
                self.done_spinner.stop()
                self.done_spinner.set_visible(False)
                if proc.returncode != 0:
                    self.back_btn.set_sensitive(True)
                    self.next_btn.set_sensitive(True)
                    err = (proc.stderr or proc.stdout or 'Setup failed').strip()
                    self.done_sub.set_text(err)
                    return False
                self.done_sub.set_text('Setup complete! Starting your Proxim OS session…')
                subprocess.Popen(['systemctl', 'restart', 'gdm'])
                self.close()
                return False

            GLib.idle_add(finish)

        threading.Thread(target=worker, daemon=True).start()


class SetupApp(Adw.Application):
    def __init__(self, preview=False):
        super().__init__(application_id='org.proxim.Setup')
        self.preview = preview

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = SetupWindow(self, preview=self.preview)
        win.present()


def main():
    preview = '--preview' in sys.argv[1:]
    app = SetupApp(preview=preview)
    return app.run([])


if __name__ == '__main__':
    sys.exit(main())
