        erase_row.set_activatable_widget(self.erase_chk)
        self.mode_group.add(erase_row)

        self.part_chk = Gtk.CheckButton()
        self.part_chk.set_group(self.erase_chk)
        self.part_chk.connect('toggled', lambda b: self._on_mode_changed('partition', b))
        part_row = Adw.ActionRow(
            title='Install to Existing Partition (Dual-Boot / Custom)',
            subtitle='Formats only the chosen partition and keeps all other partitions',
        )
        part_row.add_prefix(self.part_chk)
        part_row.set_activatable_widget(self.part_chk)
        self.mode_group.add(part_row)

        self.root_part_row = Adw.ComboRow(title='Root (/) Partition')
        self.efi_part_row = Adw.ComboRow(title='EFI Boot Partition')
        self.root_part_row.set_visible(False)
        self.efi_part_row.set_visible(False)
        self.mode_group.add(self.root_part_row)
        self.mode_group.add(self.efi_part_row)
        box.append(self.mode_group)

        self.no_disk_lbl = Gtk.Label(
            label='No internal disk found. Connect a drive and click Refresh.',
