    def _build_network_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        hdr = Gtk.Label(label='Connect to Internet', xalign=0, hexpand=True)
        hdr.add_css_class('title-2')
        top.append(hdr)

        ref_btn = Gtk.Button.new_from_icon_name('view-refresh-symbolic')
        ref_btn.set_tooltip_text('Scan Wi-Fi Networks')
        ref_btn.connect('clicked', lambda _b: self._refresh_network())
        top.append(ref_btn)
        box.append(top)

        self.net_sub = Gtk.Label(
            label='Connect to Wi-Fi to download updates during setup, or continue offline.',
            xalign=0,
            wrap=True,
        )
        self.net_sub.add_css_class('dim-label')
        box.append(self.net_sub)

        status_group = Adw.PreferencesGroup()
        self.net_status_row = Adw.ActionRow(title='Checking connection…', subtitle='')
        self.net_status_icon = Gtk.Image.new_from_icon_name('network-wireless-symbolic')
        self.net_status_row.add_prefix(self.net_status_icon)
        status_group.add(self.net_status_row)
        box.append(status_group)

        self.wifi_group = Adw.PreferencesGroup(title='Wi-Fi Network')
        self.wifi_ssid_row = Adw.ComboRow(title='Network')
        self.wifi_group.add(self.wifi_ssid_row)
        self.wifi_pass_row = Adw.PasswordEntryRow(title='Wi-Fi Password')
        self.wifi_group.add(self.wifi_pass_row)

        conn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        conn_box.set_margin_top(6)
        self.wifi_err = Gtk.Label(xalign=0, hexpand=True, wrap=True)
        self.wifi_err.add_css_class('dim-label')
        self.wifi_err.add_css_class('caption')
        conn_box.append(self.wifi_err)

        self.wifi_connect_btn = Gtk.Button(label='Connect')
        self.wifi_connect_btn.connect('clicked', self._on_wifi_connect)
        conn_box.append(self.wifi_connect_btn)
        box.append(self.wifi_group)
        box.append(conn_box)
        self._wifi_conn_box = conn_box
        return self._wrap_page(box)

    def _refresh_network(self):
        eth_up = False
        wifi_conn = ''
        ssids = []
        try:
            out = subprocess.check_output(
                ['nmcli', '-t', '-f', 'TYPE,STATE,CONNECTION', 'dev'],
                stderr=subprocess.DEVNULL,
                text=True,
            )
            for ln in out.splitlines():
                parts = ln.split(':', 2)
                if len(parts) == 3 and parts[1] == 'connected':
                    if parts[0] == 'ethernet':
                        eth_up = True
                    elif parts[0] == 'wifi':
                        wifi_conn = parts[2]
        except Exception:
            pass

        if eth_up:
            self.net_status_row.set_title('Connected via Ethernet')
            self.net_status_row.set_subtitle('Ready for online updates — no Wi-Fi setup needed.')
            self.net_status_icon.set_from_icon_name('network-wired-symbolic')
            self.wifi_group.set_visible(False)
            self._wifi_conn_box.set_visible(False)
            return

        if wifi_conn:
            self.net_status_row.set_title(f'Connected to {wifi_conn}')
            self.net_status_row.set_subtitle('Wi-Fi is connected.')
            self.net_status_icon.set_from_icon_name('network-wireless-signal-excellent-symbolic')
        else:
            self.net_status_row.set_title('Not Connected')
            self.net_status_row.set_subtitle('Select a Wi-Fi network below or click Continue to install offline.')
            self.net_status_icon.set_from_icon_name('network-wireless-offline-symbolic')

        self.wifi_group.set_visible(True)
        self._wifi_conn_box.set_visible(True)
        try:
            wout = subprocess.check_output(
                ['nmcli', '-t', '-f', 'SSID', 'dev', 'wifi', 'list', '--rescan', 'auto'],
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=8,
            )
            seen = set()
            for raw in wout.splitlines():
                s = raw.strip()
                if s and s not in seen:
                    seen.add(s)
                    ssids.append(s)
        except Exception:
            pass
        if not ssids:
            ssids = ['No Wi-Fi networks found']
            self.wifi_connect_btn.set_sensitive(False)
        else:
            self.wifi_connect_btn.set_sensitive(True)
        self.wifi_ssid_row.set_model(Gtk.StringList.new(ssids))

    def _on_wifi_connect(self, _btn):
        item = self.wifi_ssid_row.get_selected_item()
        ssid = item.get_string() if item else ''
        if not ssid or ssid == 'No Wi-Fi networks found':
            return
        pw = self.wifi_pass_row.get_text()
        self.wifi_connect_btn.set_sensitive(False)
        self.wifi_err.set_text(f'Connecting to {ssid}…')

        def worker():
            cmd = ['nmcli', 'dev', 'wifi', 'connect', ssid]
            if pw:
                cmd += ['password', pw]
            proc = subprocess.run(cmd, capture_output=True, text=True)

            def done():
                self.wifi_connect_btn.set_sensitive(True)
                if proc.returncode == 0:
                    self.wifi_err.set_text(f'Connected to {ssid}.')
                    self._refresh_network()
                else:
                    msg = (proc.stderr or proc.stdout or 'Connection failed').strip()
                    self.wifi_err.set_text(msg.splitlines()[-1] if msg else 'Connection failed')
                return False

            GLib.idle_add(done)

        threading.Thread(target=worker, daemon=True).start()

    def _on_tz_changed(self, row, _pspec):
        if row.has_focus():
            self._tz_edited = True

    def _auto_detect_timezone_async(self):
        if self._tz_edited:
            return

        def worker():
            tz = detect_ip_timezone()
            if not tz or tz not in self._zones:
                return

            def apply_tz():
                if not self._tz_edited and tz in self._zones:
                    self.tz_row.set_selected(self._zones.index(tz))
                    self.auto_tz_row.set_subtitle(f'Detected {tz} from internet • Automatic NTP clock enabled')
                return False

            GLib.idle_add(apply_tz)

        threading.Thread(target=worker, daemon=True).start()

    def _on_fullname_changed(self, row):
        if not self._username_edited:
            raw = row.get_text().strip().lower()
            slug = re.sub(r'[^a-z0-9_-]+', '', raw.split()[0] if raw else '')
            self.username_row.set_text(slug[:24])
        self._validate_account()

    def _on_username_changed(self, row):
        if row.has_focus():
            self._username_edited = True
        self._validate_account()

    def _validate_account(self):
        if self._page != 3:
            return True
        user = self.username_row.get_text().strip().lower()
        p1 = self.pass_row.get_text()
        p2 = self.confirm_row.get_text()
        host = self.host_row.get_text().strip().lower()
        err = ''
        if not user:
            err = 'Enter an account name.'
        elif not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', user):
            err = 'Account name must start with a letter and use lowercase letters, numbers, - or _.'
        elif not p1:
            err = 'Enter a password.'
        elif p1 != p2:
            err = 'Passwords do not match.'
        elif host and not re.fullmatch(r'[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?', host):
            err = 'Computer name can only contain lowercase letters, numbers, and hyphens.'
        self.account_err.set_text(err)
        ok = (err == '')
        self.next_btn.set_sensitive(ok)
        return ok

    def _refresh_disks(self):
        for r in self.disk_rows:
            self.disk_group.remove(r)
        self.disk_rows.clear()
        self._disks, self._partitions = detect_install_disks()
        self._selected_disk = self._disks[0][0] if self._disks else None
        self.no_disk_lbl.set_visible(len(self._disks) == 0)

        first_chk = None
        for idx, (dev_path, title, sub) in enumerate(self._disks):
            row = Adw.ActionRow(title=title, subtitle=sub)
            chk = Gtk.CheckButton()
            if first_chk is None:
                first_chk = chk
            else:
                chk.set_group(first_chk)
            chk.set_active(idx == 0)
            chk.connect('toggled', lambda btn, p=dev_path: self._on_disk_toggled(btn, p))
            row.add_prefix(chk)
            row.set_activatable_widget(chk)
            self.disk_group.add(row)
            self.disk_rows.append(row)

        root_labels = [p[1] for p in self._partitions if not p[3]] or ['No non-EFI partitions found']
        efi_labels = [p[1] for p in self._partitions if p[3]] or ['None (Legacy BIOS)']
        self.root_part_row.set_model(Gtk.StringList.new(root_labels))
        self.efi_part_row.set_model(Gtk.StringList.new(efi_labels))

        if self._page == 4:
            self.next_btn.set_sensitive(self._selected_disk is not None)

    def _on_mode_changed(self, mode, btn):
        if btn.get_active():
            self._install_mode = mode
            show_part = (mode == 'partition')
            self.root_part_row.set_visible(show_part)
            self.efi_part_row.set_visible(show_part)

    def _on_disk_toggled(self, btn, path):
        if btn.get_active():
            self._selected_disk = path

    def _update_summary(self):
        disk_label = self._selected_disk or '—'
        for p, title, _s in self._disks:
            if p == self._selected_disk:
                disk_label = f'{title}  ({p})'
                break
        tz_item = self.tz_row.get_selected_item()
        self.sum_disk_row.set_subtitle(disk_label)
        self.sum_user_row.set_subtitle(self.username_row.get_text().strip().lower())
        self.sum_host_row.set_subtitle(self.host_row.get_text().strip().lower() or 'proxim')
        self.sum_tz_row.set_subtitle(tz_item.get_string() if tz_item else 'UTC')

    def _go_to(self, idx):
        self._page = idx
        self.carousel.scroll_to(self.carousel.get_nth_page(idx), True)
        self.try_btn.set_visible(idx == 0)
        self.back_btn.set_visible(idx in (1, 2, 3, 4, 5))
        self.next_btn.remove_css_class('destructive-action')
        self.next_btn.add_css_class('suggested-action')

        if idx == 0:
            self.next_btn.set_label('Install Proxim OS')
            self.next_btn.set_visible(True)
            self.next_btn.set_sensitive(True)
        elif idx == 1:
            self._refresh_network()
            self.next_btn.set_label('Continue')
            self.next_btn.set_visible(True)
            self.next_btn.set_sensitive(True)
        elif idx == 2:
            self._auto_detect_timezone_async()
            self.next_btn.set_label('Continue')
            self.next_btn.set_visible(True)
            self.next_btn.set_sensitive(True)
        elif idx == 3:
            self.next_btn.set_label('Continue')
            self.next_btn.set_visible(True)
            self._validate_account()
        elif idx == 4:
            self._refresh_disks()
            self.next_btn.set_label('Continue')
            self.next_btn.set_visible(True)
            self.next_btn.set_sensitive(self._selected_disk is not None)
        elif idx == 5:
            self._update_summary()
            self.next_btn.set_label('Erase Disk & Install')
            self.next_btn.remove_css_class('suggested-action')
            self.next_btn.add_css_class('destructive-action')
            self.next_btn.set_visible(True)
            self.next_btn.set_sensitive(True)
        elif idx == 6:
            self.next_btn.set_visible(False)
        else:
            self.next_btn.set_label('Restart Now')
            self.next_btn.set_visible(True)
            self.next_btn.set_sensitive(True)

    def _on_try_live(self, _btn):
        if not self.preview:
            try:
                with open('/tmp/kos-live-tried', 'w', encoding='utf-8') as fh:
                    fh.write('1\n')
            except OSError:
                pass
        self.close()

    def _on_back(self, _btn):
        if 1 <= self._page <= 5:
            self._go_to(self._page - 1)

    def _on_next(self, _btn):
        if self._page == 3 and not self._validate_account():
            return
        if self._page < 5:
            self._go_to(self._page + 1)
        elif self._page == 5 and self._selected_disk:
            self._start_install()
        elif self._page == 7:
            subprocess.Popen(['systemctl', 'reboot'])
            self.close()

    def _start_install(self):
        if self.preview:
            self._go_to(7)
            return
        self._installing = True
        self.set_deletable(False)
        self._go_to(6)
        self.inst_bar.set_fraction(0.02)
        self.inst_msg.set_text(f'Starting installation on {self._selected_disk}…')

        tz_item = self.tz_row.get_selected_item()
        root_parts = [p[0] for p in self._partitions if not p[3]]
        efi_parts = [p[0] for p in self._partitions if p[3]]
        sel_root = root_parts[self.root_part_row.get_selected()] if root_parts else ''
        sel_efi = efi_parts[self.efi_part_row.get_selected()] if efi_parts else ''
        payload = {
            'mode': self._install_mode,
            'disk': self._selected_disk,
            'partition': sel_root,
            'efi_partition': sel_efi,
            'download_updates': self.updates_switch.get_active(),
            'full_name': self.full_name_row.get_text().strip(),
            'username': self.username_row.get_text().strip().lower(),
            'password': self.pass_row.get_text(),
            'hostname': self.host_row.get_text().strip().lower() or 'proxim',
            'timezone': tz_item.get_string() if tz_item else 'UTC',
            'autologin': self.autologin_switch.get_active(),
        }

        def worker():
            proc = subprocess.Popen(
                ['pkexec', '/usr/libexec/kos-install-helper'],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
            )
            proc.stdin.write(json.dumps(payload))
            proc.stdin.close()
            last_err = ''
            for line in proc.stdout:
                line = line.strip()
                if line.startswith('PCT '):
                    try:
                        frac = max(0.0, min(1.0, float(line[4:])))
                        GLib.idle_add(self.inst_bar.set_fraction, frac)
                    except ValueError:
                        pass
                elif line.startswith('MSG '):
                    GLib.idle_add(self.inst_msg.set_text, line[4:])
                elif line.startswith('ERROR '):
                    last_err = line[6:]
            rc = proc.wait()

            def finish():
                self._installing = False
                self.set_deletable(True)
                if rc == 0:
                    self._go_to(7)
                else:
                    self.inst_msg.set_text(last_err or 'Installation failed.')
                    self.back_btn.set_visible(True)
                    self._page = 5
                return False

            GLib.idle_add(finish)

        threading.Thread(target=worker, daemon=True).start()


class SetupApp(Adw.Application):
    def __init__(self, preview=False):
        super().__init__(application_id='org.proxim.Setup')
        self.preview = preview

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = InstallerWindow(self, preview=self.preview)
        win.present()


def main():
    args = sys.argv[1:]
    preview = '--preview' in args
    app = SetupApp(preview=preview)
    return app.run([])


if __name__ == '__main__':
    sys.exit(main())
