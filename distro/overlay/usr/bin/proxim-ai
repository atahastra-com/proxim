def _launch_desktop(desktop_id):
    info = Gio.DesktopAppInfo.new(desktop_id)
    if info:
        info.launch([], None)
        return True
    return False


def execute_tool(name, args):
    try:
        if name == 'open_app':
            target = str(args.get('target', '')).strip()
            if not target:
                return 'Error: missing target.'
            if target.startswith(('http://', 'https://', 'mailto:')) or os.path.exists(os.path.expanduser(target)):
                path = os.path.expanduser(target) if not target.startswith(('http://', 'https://', 'mailto:')) else target
                Gio.AppInfo.launch_default_for_uri(
                    path if '://' in path else GLib.filename_to_uri(os.path.abspath(path), None),
                    None,
                )
                return f'Opened {target}.'
            low = target.lower()
            desktop = APP_ALIASES.get(low)
            if desktop and _launch_desktop(desktop):
                return f'Launched {target}.'
            # Search all installed desktop apps by display name, executable, or id
            for info in Gio.AppInfo.get_all():
                if not info.should_show():
                    continue
                hay = ' '.join(filter(None, [
                    info.get_name(),
                    info.get_display_name(),
                    info.get_id(),
                    info.get_executable(),
                ])).lower()
                if low in hay:
                    info.launch([], None)
                    return f'Launched {info.get_display_name() or target}.'
            for bin_name in (low, f'{low}-esr'):
                if shutil.which(bin_name):
                    subprocess.Popen([bin_name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    return f'Launched {bin_name}.'
            return f'Could not find app "{target}".'

        if name == 'system_control':
            action = str(args.get('action', '')).lower()
            val = str(args.get('value', '')).strip().lower()
            if action == 'volume':
                if val in ('mute', 'off'):
                    subprocess.run(['wpctl', 'set-mute', '@DEFAULT_AUDIO_SINK@', '1'], check=False)
                    return 'Muted audio.'
                if val in ('unmute', 'on'):
                    subprocess.run(['wpctl', 'set-mute', '@DEFAULT_AUDIO_SINK@', '0'], check=False)
                    return 'Unmuted audio.'
                m = re.search(r'\d+', val)
                if m:
                    pct = max(0, min(100, int(m.group(0))))
                    subprocess.run(['wpctl', 'set-mute', '@DEFAULT_AUDIO_SINK@', '0'], check=False)
                    subprocess.run(['wpctl', 'set-volume', '@DEFAULT_AUDIO_SINK@', f'{pct}%'], check=False)
                    return f'Set volume to {pct}%.'
                out = subprocess.run(['wpctl', 'get-volume', '@DEFAULT_AUDIO_SINK@'], capture_output=True, text=True)
                return out.stdout.strip() or 'Could not read volume.'
            if action == 'wifi':
                if val in ('on', 'off'):
                    r = subprocess.run(['nmcli', 'radio', 'wifi', val], capture_output=True, text=True)
                    return f'Wi-Fi turned {val}.' if r.returncode == 0 else (r.stderr.strip() or 'Failed.')
                if val == 'list':
                    r = subprocess.run(['nmcli', '-t', '-f', 'SSID,SIGNAL,SECURITY', 'dev', 'wifi', 'list'], capture_output=True, text=True)
                    return r.stdout.strip() or 'No Wi-Fi networks found.'
                r = subprocess.run(['nmcli', '-t', '-f', 'DEVICE,TYPE,STATE,CONNECTION', 'dev'], capture_output=True, text=True)
                return r.stdout.strip() or 'No network status available.'
            if action == 'dnd':
                show = 'false' if val in ('on', 'true', 'enable', '1') else 'true'
                subprocess.run(['gsettings', 'set', 'org.gnome.desktop.notifications', 'show-banners', show], check=False)
                return f"Do Not Disturb {'enabled' if show == 'false' else 'disabled'}."
            if action == 'lock':
                subprocess.Popen(['loginctl', 'lock-session'])
                return 'Locked the screen.'
            if action == 'screenshot':
                out_path = os.path.expanduser('~/Pictures/proxim-screenshot.png')
                os.makedirs(os.path.dirname(out_path), exist_ok=True)
                if shutil.which('gnome-screenshot'):
                    subprocess.Popen(['gnome-screenshot', '-f', out_path])
                    return f'Screenshot saved to {out_path}.'
                return 'Screenshot tool not available.'
            if action == 'reboot':
                subprocess.Popen(['systemctl', 'reboot'])
                return 'Rebooting Proxim OS…'
            if action == 'shutdown':
                subprocess.Popen(['systemctl', 'poweroff'])
                return 'Shutting down Proxim OS…'
            return f'Unknown system action: {action}'

        if name == 'read_file':
            p = os.path.expanduser(str(args.get('path', '')))
            with open(p, encoding='utf-8', errors='replace') as fh:
                data = fh.read(16384)
            return data if data else '(empty file)'

        if name == 'write_file':
            p = os.path.expanduser(str(args.get('path', '')))
            os.makedirs(os.path.dirname(os.path.abspath(p)), exist_ok=True)
            with open(p, 'w', encoding='utf-8') as fh:
                fh.write(str(args.get('content', '')))
            return f'Wrote {p}.'

        if name == 'list_dir':
            p = os.path.expanduser(str(args.get('path', '~')) or '~')
            entries = sorted(os.listdir(p))
            out = []
            for e in entries[:120]:
                full = os.path.join(p, e)
                out.append(e + ('/' if os.path.isdir(full) else ''))
            return '\n'.join(out) or '(empty directory)'

        if name == 'system_info':
            parts = []
            for label, cmd in (
                ('Uptime', ['uptime', '-p']),
                ('Memory', ['free', '-h']),
                ('Disk', ['df', '-h', '/']),
                ('IP', ['hostname', '-I']),
            ):
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
                if r.stdout.strip():
                    parts.append(f'{label}:\n{r.stdout.strip()}')
            return '\n\n'.join(parts)

        if name == 'run_shell':
            cmd = str(args.get('command', '')).strip()
            if not cmd:
                return 'Error: empty command.'
            r = subprocess.run(
                ['bash', '-lc', cmd],
                capture_output=True,
                text=True,
                timeout=30,
                cwd=os.path.expanduser('~'),
            )
            out = (r.stdout or '') + (('\n' + r.stderr) if r.stderr else '')
            out = out.strip()
            if len(out) > 8000:
                out = out[:8000] + '\n…(truncated)'
            return f'(exit {r.returncode})\n{out}' if out else f'(exit {r.returncode})'

        return f'Unknown tool: {name}'
    except Exception as exc:
        return f'Tool error ({name}): {exc}'


# ---- LLM Provider Clients (stdlib urllib only) -----------------------------

def http_post_json(url, payload, headers=None, timeout=60):
    hdrs = {'Content-Type': 'application/json', 'User-Agent': 'ProximAI/1.0'}
    if headers:
        hdrs.update(headers)
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode('utf-8'),
        headers=hdrs,
        method='POST',
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode('utf-8'))
    except urllib.error.HTTPError as err:
        body = err.read().decode('utf-8', errors='replace')
        raise RuntimeError(f'HTTP {err.code}: {body[:300]}')


def call_gemini(cfg, messages):
    api_key = cfg.get('api_key', '').strip()
    if not api_key:
        raise RuntimeError('Missing Gemini API key. Click the gear icon above to add it.')
    model = cfg.get('model') or PROVIDER_DEFAULTS['gemini']
    url = f'https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}'

    contents = []
    for m in messages:
        role = 'user' if m['role'] in ('user', 'tool') else 'model'
        parts = []
        if m['role'] == 'tool':
            parts.append({
                'functionResponse': {
                    'name': m['name'],
                    'response': {'result': m['content']},
                }
            })
        else:
            if m.get('content'):
                parts.append({'text': m['content']})
            for tc in m.get('tool_calls') or []:
                parts.append({'functionCall': {'name': tc['name'], 'args': tc['args']}})
        if parts:
            contents.append({'role': role, 'parts': parts})

    payload = {
        'systemInstruction': {'parts': [{'text': SYSTEM_PROMPT}]},
        'contents': contents,
        'tools': [{'functionDeclarations': TOOLS_SPEC}],
    }
    data = http_post_json(url, payload)
    cand = (data.get('candidates') or [{}])[0]
    parts = (cand.get('content') or {}).get('parts') or []
    text_parts = []
    tool_calls = []
    for idx, p in enumerate(parts):
        if 'text' in p:
            text_parts.append(p['text'])
        if 'functionCall' in p:
            fc = p['functionCall']
            tool_calls.append({
                'id': f'call_{idx}',
                'name': fc.get('name', ''),
                'args': fc.get('args') or {},
            })
    return '\n'.join(text_parts).strip(), tool_calls


def call_openai_compat(cfg, messages, mode='openai'):
    model = cfg.get('model') or PROVIDER_DEFAULTS.get(mode, 'gpt-4o-mini')
    if mode == 'ollama':
        base = (cfg.get('ollama_url') or 'http://127.0.0.1:11434').rstrip('/')
        url = base if base.endswith('/chat/completions') else f'{base}/v1/chat/completions'
        headers = {}
    elif mode == 'custom':
        url = (cfg.get('custom_url') or '').strip()
        if not url:
            raise RuntimeError('Missing Custom Endpoint URL. Click the gear icon above to add it.')
        if not url.endswith('/chat/completions') and '/chat/completions' not in url:
            url = url.rstrip('/') + '/chat/completions'
        api_key = cfg.get('api_key', '').strip()
        headers = {'Authorization': f'Bearer {api_key}'} if api_key else {}
    else:
        api_key = cfg.get('api_key', '').strip()
        if not api_key:
            raise RuntimeError('Missing OpenAI API key. Click the gear icon above to add it.')
        url = cfg.get('openai_url') or DEFAULT_CONFIG['openai_url']
        headers = {'Authorization': f'Bearer {api_key}'}

    oai_msgs = [{'role': 'system', 'content': SYSTEM_PROMPT}]
    for m in messages:
        if m['role'] == 'tool':
            oai_msgs.append({
                'role': 'tool',
                'tool_call_id': m.get('tool_call_id', 'call_0'),
                'content': m['content'],
            })
        elif m['role'] == 'assistant' and m.get('tool_calls'):
            oai_msgs.append({
                'role': 'assistant',
                'content': m.get('content') or '',
                'tool_calls': [
                    {
                        'id': tc['id'],
                        'type': 'function',
                        'function': {'name': tc['name'], 'arguments': json.dumps(tc['args'])},
                    }
                    for tc in m['tool_calls']
                ],
            })
        else:
            oai_msgs.append({'role': m['role'], 'content': m.get('content', '')})

    tools = [{'type': 'function', 'function': t} for t in TOOLS_SPEC]
    payload = {'model': model, 'messages': oai_msgs, 'tools': tools}
    data = http_post_json(url, payload, headers=headers)
    msg = ((data.get('choices') or [{}])[0]).get('message') or {}
    text = (msg.get('content') or '').strip()
    tool_calls = []
    for idx, tc in enumerate(msg.get('tool_calls') or []):
        fn = tc.get('function') or {}
        raw_args = fn.get('arguments') or '{}'
        try:
            parsed = json.loads(raw_args) if isinstance(raw_args, str) else raw_args
        except Exception:
            parsed = {}
        tool_calls.append({
            'id': tc.get('id') or f'call_{idx}',
            'name': fn.get('name', ''),
            'args': parsed,
        })
    return text, tool_calls


def call_claude(cfg, messages):
    api_key = cfg.get('api_key', '').strip()
    if not api_key:
        raise RuntimeError('Missing Claude API key. Click the gear icon above to add it.')
    model = cfg.get('model') or PROVIDER_DEFAULTS['claude']
    url = 'https://api.anthropic.com/v1/messages'
    headers = {
        'x-api-key': api_key,
        'anthropic-version': '2023-06-01',
    }
    anth_msgs = []
    for m in messages:
        if m['role'] == 'tool':
            anth_msgs.append({
                'role': 'user',
                'content': [{
                    'type': 'tool_result',
                    'tool_use_id': m.get('tool_call_id', 'call_0'),
                    'content': m['content'],
                }],
            })
        elif m['role'] == 'assistant' and m.get('tool_calls'):
            blocks = []
            if m.get('content'):
                blocks.append({'type': 'text', 'text': m['content']})
            for tc in m['tool_calls']:
                blocks.append({'type': 'tool_use', 'id': tc['id'], 'name': tc['name'], 'input': tc['args']})
            anth_msgs.append({'role': 'assistant', 'content': blocks})
        else:
            anth_msgs.append({'role': m['role'], 'content': m.get('content', '')})

    tools = [
        {'name': t['name'], 'description': t['description'], 'input_schema': t['parameters']}
        for t in TOOLS_SPEC
    ]
    payload = {
        'model': model,
        'max_tokens': 2048,
        'system': SYSTEM_PROMPT,
        'messages': anth_msgs,
        'tools': tools,
    }
    data = http_post_json(url, payload, headers=headers)
    text_parts = []
    tool_calls = []
    for blk in data.get('content') or []:
        if blk.get('type') == 'text':
            text_parts.append(blk.get('text', ''))
        elif blk.get('type') == 'tool_use':
            tool_calls.append({
                'id': blk.get('id', 'call_0'),
                'name': blk.get('name', ''),
                'args': blk.get('input') or {},
            })
    return '\n'.join(text_parts).strip(), tool_calls


def detect_bedrock_region(api_key):
    """Extract AWS region from a short-term bedrock-api-key-... token if present."""
    if not api_key or not api_key.startswith('bedrock-api-key-'):
        return None
    try:
        b64 = api_key[len('bedrock-api-key-'):]
        pad = '=' * (-len(b64) % 4)
        decoded = urllib.parse.unquote(base64.b64decode(b64 + pad).decode('utf-8', errors='ignore'))
        m = re.search(r'X-Amz-Credential=[^&/]+/\d{8}/([a-z]{2}-[a-z]+-\d+)/bedrock', decoded)
        if m:
            return m.group(1)
    except Exception:
        pass
    return None


def call_bedrock(cfg, messages):
    api_key = cfg.get('api_key', '').strip()
    if not api_key:
        raise RuntimeError('Missing AWS Bedrock API key. Click the gear icon above to add it.')
    region = detect_bedrock_region(api_key) or (cfg.get('bedrock_region') or 'us-east-1').strip()
    model = (cfg.get('model') or PROVIDER_DEFAULTS['bedrock']).strip()
    encoded_model = urllib.parse.quote(model, safe='')
    url = f'https://bedrock-runtime.{region}.amazonaws.com/model/{encoded_model}/converse'
    headers = {'Authorization': f'Bearer {api_key}'}

    br_msgs = []
    for m in messages:
        if m['role'] == 'tool':
            br_msgs.append({
                'role': 'user',
                'content': [{
                    'toolResult': {
                        'toolUseId': m.get('tool_call_id', 'call_0'),
                        'content': [{'text': m['content']}],
                    }
                }],
            })
        elif m['role'] == 'assistant' and m.get('tool_calls'):
            blocks = []
            if m.get('content'):
                blocks.append({'text': m['content']})
            for tc in m['tool_calls']:
                blocks.append({
                    'toolUse': {
                        'toolUseId': tc['id'],
                        'name': tc['name'],
                        'input': tc['args'],
                    }
                })
            br_msgs.append({'role': 'assistant', 'content': blocks})
        else:
            role = 'user' if m['role'] == 'user' else 'assistant'
            br_msgs.append({'role': role, 'content': [{'text': m.get('content', '')}]})

    br_tools = [
        {
            'toolSpec': {
                'name': t['name'],
                'description': t['description'],
                'inputSchema': {'json': t['parameters']},
            }
        }
        for t in TOOLS_SPEC
    ]
    payload = {
        'system': [{'text': SYSTEM_PROMPT}],
        'messages': br_msgs,
        'toolConfig': {'tools': br_tools},
    }
    data = http_post_json(url, payload, headers=headers)
    msg = ((data.get('output') or {}).get('message')) or {}
    text_parts = []
    tool_calls = []
    for blk in msg.get('content') or []:
        if 'text' in blk:
            text_parts.append(blk['text'])
        elif 'toolUse' in blk:
            tu = blk['toolUse']
            tool_calls.append({
                'id': tu.get('toolUseId', 'call_0'),
                'name': tu.get('name', ''),
                'args': tu.get('input') or {},
            })
    return '\n'.join(text_parts).strip(), tool_calls


def call_llm(cfg, messages):
    prov = (cfg.get('provider') or 'gemini').lower()
    if prov == 'gemini':
        return call_gemini(cfg, messages)
    if prov == 'claude':
        return call_claude(cfg, messages)
    if prov == 'bedrock':
        return call_bedrock(cfg, messages)
    if prov == 'custom':
        return call_openai_compat(cfg, messages, mode='custom')
    if prov == 'ollama':
        return call_openai_compat(cfg, messages, mode='ollama')
    return call_openai_compat(cfg, messages, mode='openai')


# ---- GTK4 / Libadwaita Dark-Glass Chat UI ----------------------------------

