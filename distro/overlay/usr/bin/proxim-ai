class ProximAIWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title='Proxim AI')
        self.set_default_size(420, 720)
        self.cfg = load_config()
        self.messages = []
        self._busy = False
        self._cancel_flag = False

        provider = Gtk.CssProvider()
        provider.load_from_string(APP_CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1
        )

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_decoration_layout(':close')

        new_btn = Gtk.Button(icon_name='document-new-symbolic')
        new_btn.set_tooltip_text('New Chat')
        new_btn.connect('clicked', lambda _b: self._clear_chat())
        header.pack_start(new_btn)

        settings_btn = Gtk.Button(icon_name='emblem-system-symbolic')
        settings_btn.set_tooltip_text('AI Model & API Key')
        settings_btn.connect('clicked', lambda _b: self._open_settings())
        header.pack_end(settings_btn)

        toolbar.add_top_bar(header)

        root_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        self.scroll = Gtk.ScrolledWindow(vexpand=True)
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        self.chat_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.chat_box.set_margin_top(12)
        self.chat_box.set_margin_bottom(12)
        self.chat_box.set_margin_start(16)
        self.chat_box.set_margin_end(16)
        self.scroll.set_child(self.chat_box)
        root_box.append(self.scroll)

        # Bottom input bar
        bottom = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bottom.set_margin_top(6)
        bottom.set_margin_bottom(14)
        bottom.set_margin_start(14)
        bottom.set_margin_end(14)
        bottom.add_css_class('proxim-ai-input-bar')

        self.entry = Gtk.Entry(hexpand=True)
        self.entry.set_placeholder_text('Ask Proxim AI anything…')
        self.entry.add_css_class('proxim-ai-entry')
        self.entry.connect('activate', lambda _e: self._on_send())
        bottom.append(self.entry)

        self.spinner = Gtk.Spinner()
        self.spinner.set_visible(False)
        bottom.append(self.spinner)

        self.send_btn = Gtk.Button(icon_name='go-up-symbolic')
        self.send_btn.add_css_class('proxim-ai-send')
        self.send_btn.set_tooltip_text('Send')
        self.send_btn.connect('clicked', lambda _b: self._on_send())
        bottom.append(self.send_btn)

        root_box.append(bottom)
        toolbar.set_content(root_box)
        self.set_content(toolbar)

        self._show_welcome()
        self.entry.grab_focus()

    def _scroll_bottom(self):
        def _do():
            adj = self.scroll.get_vadjustment()
            adj.set_value(adj.get_upper())
            return False
        GLib.idle_add(_do)

    def _clear_chat(self):
        self._cancel_flag = True
        self.messages.clear()
        child = self.chat_box.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.chat_box.remove(child)
            child = nxt
        self._show_welcome()
        self.entry.grab_focus()

    def _show_welcome(self):
        self.welcome_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.welcome_box.set_valign(Gtk.Align.CENTER)
        self.welcome_box.set_vexpand(True)
        self.welcome_box.set_margin_top(48)

        logo = Gtk.Image.new_from_icon_name('proxim-logo')
        logo.set_pixel_size(52)
        self.welcome_box.append(logo)

        title = Gtk.Label(label='Proxim AI')
        title.add_css_class('title-2')
        self.welcome_box.append(title)

        sub = Gtk.Label(
            label='Ask anything or tell me to do it on your OS.',
            wrap=True,
            justify=Gtk.Justification.CENTER,
        )
        sub.add_css_class('dim-label')
        self.welcome_box.append(sub)

        chips = Gtk.FlowBox()
        chips.set_selection_mode(Gtk.SelectionMode.NONE)
        chips.set_halign(Gtk.Align.CENTER)
        chips.set_max_children_per_line(2)
        chips.set_row_spacing(8)
        chips.set_column_spacing(8)
        chips.set_margin_top(10)

        for prompt in (
            'Open Firefox',
            'Check disk & RAM',
            'Set volume to 50%',
            'List my Desktop files',
        ):
            btn = Gtk.Button(label=prompt)
            btn.add_css_class('proxim-ai-chip')
            btn.add_css_class('flat')
            btn.connect('clicked', lambda _b, p=prompt: self._send_text(p))
            chips.append(btn)

        self.welcome_box.append(chips)

        if self.cfg.get('provider') != 'ollama' and not self.cfg.get('api_key'):
            setup_btn = Gtk.Button(label='Set up API Key or Ollama')
            setup_btn.add_css_class('pill')
            setup_btn.add_css_class('suggested-action')
            setup_btn.set_halign(Gtk.Align.CENTER)
            setup_btn.set_margin_top(12)
            setup_btn.connect('clicked', lambda _b: self._open_settings())
            self.welcome_box.append(setup_btn)

        self.chat_box.append(self.welcome_box)

    def _hide_welcome(self):
        if getattr(self, 'welcome_box', None) and self.welcome_box.get_parent() == self.chat_box:
            self.chat_box.remove(self.welcome_box)
            self.welcome_box = None

    def _add_bubble(self, text, is_user=False):
        self._hide_welcome()
        lbl = Gtk.Label(xalign=0, wrap=True, selectable=True)
        lbl.set_max_width_chars(46)
        if is_user:
            lbl.set_text(text)
        else:
            # Render simple **bold** and `code` via safe escaped Pango markup.
            esc = GLib.markup_escape_text(text)
            esc = re.sub(r'\*\*(.+?)\*\*', r'<b>\1</b>', esc)
            esc = re.sub(r'`([^`]+)`', r'<tt>\1</tt>', esc)
            try:
                lbl.set_markup(esc)
            except Exception:
                lbl.set_text(text)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        box.set_halign(Gtk.Align.END if is_user else Gtk.Align.START)
        box.add_css_class('proxim-ai-user' if is_user else 'proxim-ai-bot')
        box.append(lbl)
        self.chat_box.append(box)
        self._scroll_bottom()
        return False

    def _add_tool_pill(self, text):
        self._hide_welcome()
        lbl = Gtk.Label(label=text, xalign=0, wrap=True)
        lbl.set_max_width_chars(52)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        box.set_halign(Gtk.Align.START)
        box.add_css_class('proxim-ai-tool')
        box.append(lbl)
        self.chat_box.append(box)
        self._scroll_bottom()
        return False

    def _ask_confirmation(self, summary):
        ev = threading.Event()
        result = {'allow': False}

        def _show():
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            card.add_css_class('proxim-ai-confirm')

            lbl = Gtk.Label(label=f'Confirm action:\n{summary}', xalign=0, wrap=True)
            card.append(lbl)

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            row.set_halign(Gtk.Align.END)

            deny_btn = Gtk.Button(label='Deny')
            deny_btn.add_css_class('pill')
            allow_btn = Gtk.Button(label='Allow')
            allow_btn.add_css_class('pill')
            allow_btn.add_css_class('suggested-action')

            def decide(ok):
                result['allow'] = ok
                deny_btn.set_sensitive(False)
                allow_btn.set_sensitive(False)
                lbl.set_text(f"{'Allowed' if ok else 'Denied'}: {summary}")
                ev.set()

            deny_btn.connect('clicked', lambda _b: decide(False))
            allow_btn.connect('clicked', lambda _b: decide(True))
            row.append(deny_btn)
            row.append(allow_btn)
            card.append(row)
            self.chat_box.append(card)
            self._scroll_bottom()
            return False

        GLib.idle_add(_show)
        ev.wait()
        return result['allow']

    def _set_busy(self, busy):
        self._busy = busy
        self.spinner.set_visible(busy)
        if busy:
            self.spinner.start()
        else:
            self.spinner.stop()
        self.send_btn.set_sensitive(not busy)
        self.entry.set_sensitive(not busy)
        if not busy:
            self.entry.grab_focus()
        return False

    def _on_send(self):
        text = self.entry.get_text().strip()
        if not text or self._busy:
            return
        self.entry.set_text('')
        self._send_text(text)

    def _send_text(self, text):
        if self._busy:
            return
        self._cancel_flag = False
        self._add_bubble(text, is_user=True)
        self.messages.append({'role': 'user', 'content': text})
        self._set_busy(True)
        threading.Thread(target=self._agent_loop, daemon=True).start()

    def _agent_loop(self):
        try:
            for _step in range(15):
                if self._cancel_flag:
                    break
                text, tool_calls = call_llm(self.cfg, self.messages)
                self.messages.append({
                    'role': 'assistant',
                    'content': text,
                    'tool_calls': tool_calls,
                })
                if text:
                    GLib.idle_add(self._add_bubble, text, False)
                if not tool_calls:
                    break
                for tc in tool_calls:
                    if self._cancel_flag:
                        break
                    tname = tc['name']
                    targs = tc['args']
                    desc = f"{tname}({', '.join(f'{k}={v}' for k, v in targs.items())})"
                    if len(desc) > 120:
                        desc = desc[:117] + '…'

                    if is_destructive(tname, targs):
                        allowed = self._ask_confirmation(desc)
                        if not allowed:
                            self.messages.append({
                                'role': 'tool',
                                'tool_call_id': tc['id'],
                                'name': tname,
                                'content': 'User denied this action.',
                            })
                            continue

                    GLib.idle_add(self._add_tool_pill, f'⚡ {desc}')
                    out = execute_tool(tname, targs)
                    self.messages.append({
                        'role': 'tool',
                        'tool_call_id': tc['id'],
                        'name': tname,
                        'content': out,
                    })
        except Exception as exc:
            GLib.idle_add(self._add_bubble, f'Error: {exc}', False)
        finally:
            GLib.idle_add(self._set_busy, False)

    def _open_settings(self):
        dlg = Adw.Dialog(title='Proxim AI Settings')
        dlg.set_content_width(420)
        dlg.set_content_height(430)

        tv = Adw.ToolbarView()
        hb = Adw.HeaderBar()
        tv.add_top_bar(hb)

        scroll = Gtk.ScrolledWindow(vexpand=True)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_margin_top(16)
        box.set_margin_bottom(20)
        box.set_margin_start(18)
        box.set_margin_end(18)

        providers = ['gemini', 'openai', 'claude', 'bedrock', 'custom', 'ollama']
        labels = [
            'Google Gemini',
            'OpenAI (ChatGPT)',
            'Anthropic Claude',
            'AWS Bedrock (API Key)',
            'Custom OpenAI-Compatible (OpenRouter, Groq, etc.)',
            'Local Ollama (Offline)',
        ]

        prov_row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        prov_row.append(Gtk.Label(label='Provider', xalign=0))
        dropdown = Gtk.DropDown.new_from_strings(labels)
        cur_idx = providers.index(self.cfg.get('provider', 'gemini')) if self.cfg.get('provider') in providers else 0
        dropdown.set_selected(cur_idx)
        prov_row.append(dropdown)
        box.append(prov_row)

        model_row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        model_row.append(Gtk.Label(label='Model ID', xalign=0))
        model_entry = Gtk.Entry(text=self.cfg.get('model', ''))
        model_row.append(model_entry)
        box.append(model_row)

        key_row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        key_row.append(Gtk.Label(label='API Key / Bearer Token', xalign=0))
        key_entry = Gtk.PasswordEntry()
        key_entry.set_show_peek_icon(True)
        key_entry.set_text(self.cfg.get('api_key', ''))
        key_row.append(key_entry)
        box.append(key_row)

        region_row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        region_row.append(Gtk.Label(label='AWS Region (e.g. us-east-1, us-west-2)', xalign=0))
        region_entry = Gtk.Entry(text=self.cfg.get('bedrock_region', 'us-east-1'))
        region_row.append(region_entry)
        box.append(region_row)

        custom_url_row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        custom_url_row.append(Gtk.Label(label='Endpoint URL (OpenAI-compatible /chat/completions)', xalign=0))
        custom_url_entry = Gtk.Entry(text=self.cfg.get('custom_url', 'https://openrouter.ai/api/v1/chat/completions'))
        custom_url_row.append(custom_url_entry)
        box.append(custom_url_row)

        ollama_url_row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        ollama_url_row.append(Gtk.Label(label='Ollama URL', xalign=0))
        ollama_url_entry = Gtk.Entry(text=self.cfg.get('ollama_url', 'http://127.0.0.1:11434'))
        ollama_url_row.append(ollama_url_entry)
        box.append(ollama_url_row)

        def sync_fields(reset_model=False):
            p = providers[dropdown.get_selected()]
            if reset_model:
                model_entry.set_text(PROVIDER_DEFAULTS[p])
            key_row.set_visible(p != 'ollama')
            region_row.set_visible(p == 'bedrock')
            custom_url_row.set_visible(p == 'custom')
            ollama_url_row.set_visible(p == 'ollama')

        dropdown.connect('notify::selected', lambda _dd, _ps: sync_fields(reset_model=True))
        sync_fields(reset_model=False)

        save_btn = Gtk.Button(label='Save')
        save_btn.add_css_class('suggested-action')
        save_btn.add_css_class('pill')
        save_btn.set_halign(Gtk.Align.END)

        def on_save(_b):
            p = providers[dropdown.get_selected()]
            self.cfg['provider'] = p
            self.cfg['model'] = model_entry.get_text().strip() or PROVIDER_DEFAULTS[p]
            self.cfg['api_key'] = key_entry.get_text().strip()
            self.cfg['bedrock_region'] = region_entry.get_text().strip() or 'us-east-1'
            self.cfg['custom_url'] = custom_url_entry.get_text().strip() or DEFAULT_CONFIG['custom_url']
            self.cfg['ollama_url'] = ollama_url_entry.get_text().strip() or 'http://127.0.0.1:11434'
            save_config(self.cfg)
            dlg.close()

        save_btn.connect('clicked', on_save)
        box.append(save_btn)

        scroll.set_child(box)
        tv.set_content(scroll)
        dlg.set_child(tv)
        dlg.present(self)


class ProximAIApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id='org.proxim.AI', flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None

    def do_activate(self):
        if not self.win:
            self.win = ProximAIWindow(self)
        self.win.present()

    def do_command_line(self, command_line):
        args = command_line.get_arguments()[1:]
        if '--toggle' in args and self.win and self.win.is_visible() and self.win.is_active():
            self.win.close()
            return 0
        self.activate()
        return 0


if __name__ == '__main__':
    app = ProximAIApp()
    sys.exit(app.run(sys.argv))
