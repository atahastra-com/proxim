#!/bin/bash
# Privileged disk installer for Proxim OS Live ISO (invoked via pkexec).
# Reads JSON config from stdin:
#   {mode, disk, partition, efi_partition, download_updates,
#    full_name, username, password, hostname, timezone, autologin}
set -euo pipefail

SQUASH="/run/live/medium/live/filesystem.squashfs"
VMLINUZ="/run/live/medium/live/vmlinuz"
INITRD="/run/live/medium/live/initrd.img"
TARGET="/tmp/kos-install-target"

emit() { printf '%s\n' "$1"; }
fail() { emit "ERROR $1"; exit 1; }

CFG_JSON="$(cat)"
readarray -t CFG < <(python3 -c '
import json, re, sys
d = json.loads(sys.stdin.read())
mode = str(d.get("mode", "erase")).strip()
disk = str(d.get("disk", "")).strip()
part = str(d.get("partition", "")).strip()
efi_part = str(d.get("efi_partition", "")).strip()
updates = "1" if d.get("download_updates", False) else "0"
full_name = str(d.get("full_name", "")).strip()
username = str(d.get("username", "")).strip().lower()
password = str(d.get("password", ""))
hostname = str(d.get("hostname", "")).strip().lower() or "proxim"
timezone = str(d.get("timezone", "")).strip() or "UTC"
autologin = "1" if d.get("autologin", False) else "0"
if mode not in ("erase", "partition"):
    raise SystemExit("Invalid install mode")
if not disk.startswith("/dev/"):
    raise SystemExit("Invalid disk")
if mode == "partition" and not part.startswith("/dev/"):
    raise SystemExit("Invalid root partition")
if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", username):
    raise SystemExit("Invalid username")
if not password:
    raise SystemExit("Password cannot be empty")
if not re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?", hostname):
    raise SystemExit("Invalid computer name")
for v in (mode, disk, part, efi_part, updates, full_name, username, password, hostname, timezone, autologin):
    print(v.replace("\n", " "))
' <<< "$CFG_JSON")

MODE="${CFG[0]}"
DISK="${CFG[1]}"
PART_ROOT="${CFG[2]}"
PART_EFI="${CFG[3]}"
DOWNLOAD_UPDATES="${CFG[4]}"
FULL_NAME="${CFG[5]}"
USERNAME="${CFG[6]}"
PASSWORD="${CFG[7]}"
HOSTNAME="${CFG[8]}"
TIMEZONE="${CFG[9]}"
AUTOLOGIN="${CFG[10]}"

if [[ -z "$DISK" || ! -b "$DISK" ]]; then
  fail "Invalid target disk: ${DISK}"
fi
if [[ ! -f "$SQUASH" ]]; then
  fail "Live system image not found at ${SQUASH}"
fi

LIVE_SRC="$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null || true)"
if [[ -n "$LIVE_SRC" ]]; then
  LIVE_PK="$(lsblk -no PKNAME "$LIVE_SRC" 2>/dev/null || true)"
  if [[ "$LIVE_SRC" == "${DISK}"* || "/dev/${LIVE_PK}" == "$DISK" ]]; then
    fail "Cannot install onto the live USB drive (${DISK})."
  fi
fi

cleanup() {
  set +e
  umount -R "$TARGET" 2>/dev/null || true
  rmdir "$TARGET" 2>/dev/null || true
}
trap cleanup EXIT

part_for() {
  local d="$1" n="$2"
  if [[ "$d" =~ [0-9]$ ]]; then
    printf '%sp%s\n' "$d" "$n"
  else
    printf '%s%s\n' "$d" "$n"
  fi
}

emit "PCT 0.03"
emit "MSG Preparing storage…"

if [[ "$MODE" == "erase" ]]; then
  while read -r mp; do
    [[ -n "$mp" ]] && umount -f "$mp" 2>/dev/null || true
  done < <(lsblk -nr -o MOUNTPOINT "$DISK" 2>/dev/null | grep -v '^$' || true)
  swapoff -a 2>/dev/null || true

  emit "PCT 0.06"
  emit "MSG Creating GPT partitions on ${DISK}…"
  wipefs -a "$DISK" >/dev/null 2>&1 || true
  parted -s "$DISK" mklabel gpt
  parted -s "$DISK" mkpart EFI fat32 1MiB 513MiB
  parted -s "$DISK" set 1 esp on
  parted -s "$DISK" mkpart root ext4 513MiB 100%
  partprobe "$DISK" || true
  sleep 1

  P_EFI="$(part_for "$DISK" 1)"
  P_ROOT="$(part_for "$DISK" 2)"
  for _ in $(seq 1 20); do
    [[ -b "$P_EFI" && -b "$P_ROOT" ]] && break
    sleep 0.3
  done
  [[ -b "$P_EFI" && -b "$P_ROOT" ]] || fail "Partition nodes did not appear on ${DISK}"

  emit "PCT 0.10"
  emit "MSG Formatting EFI and root partitions…"
  mkfs.vfat -F32 -n EFI "$P_EFI" >/dev/null
  mkfs.ext4 -F -L proxim-os "$P_ROOT" >/dev/null
else
  [[ -b "$PART_ROOT" ]] || fail "Invalid root partition: ${PART_ROOT}"
  for p in "$PART_ROOT" "$PART_EFI"; do
    [[ -n "$p" ]] || continue
    mp="$(lsblk -nr -o MOUNTPOINT "$p" 2>/dev/null | head -n 1 || true)"
    [[ -n "$mp" ]] && umount -f "$mp" 2>/dev/null || true
  done
  P_ROOT="$PART_ROOT"
  P_EFI="$PART_EFI"
  emit "PCT 0.10"
  emit "MSG Formatting root partition ${P_ROOT}…"
  mkfs.ext4 -F -L proxim-os "$P_ROOT" >/dev/null
fi

mkdir -p "$TARGET"
mount "$P_ROOT" "$TARGET"
if [[ -n "$P_EFI" && -b "$P_EFI" ]]; then
  mkdir -p "${TARGET}/boot/efi"
  mount "$P_EFI" "${TARGET}/boot/efi"
fi

emit "PCT 0.14"
emit "MSG Copying Proxim OS system files (this takes a minute)…"

unsquashfs -f -d "$TARGET" "$SQUASH" >/tmp/kos-unsquash.log 2>&1 &
UPID=$!
while kill -0 "$UPID" 2>/dev/null; do
  used_kib=$(df -k --output=used "$TARGET" 2>/dev/null | tail -n 1 | tr -dc '0-9')
  used_kib="${used_kib:-0}"
  frac=$(awk -v u="$used_kib" 'BEGIN { f = 0.14 + (u / 5200000.0) * 0.60; if (f > 0.74) f = 0.74; printf "%.2f", f }')
  emit "PCT ${frac}"
  sleep 1
done
wait "$UPID" || fail "Failed to extract system files (see /tmp/kos-unsquash.log)"

emit "PCT 0.76"
emit "MSG Creating user account (${USERNAME}) and system settings…"

KVER="$(ls -1 "${TARGET}/lib/modules" | sort -V | tail -n 1)"
[[ -f "$VMLINUZ" ]] && cp -f "$VMLINUZ" "${TARGET}/boot/vmlinuz-${KVER}"
[[ -f "$INITRD" ]] && cp -f "$INITRD" "${TARGET}/boot/initrd.img-${KVER}"

ROOT_UUID="$(blkid -s UUID -o value "$P_ROOT")"
{
  echo "# /etc/fstab: static file system information."
  echo "UUID=${ROOT_UUID}  /          ext4  errors=remount-ro  0  1"
  if [[ -n "$P_EFI" && -b "$P_EFI" ]]; then
    EFI_UUID="$(blkid -s UUID -o value "$P_EFI")"
    echo "UUID=${EFI_UUID}   /boot/efi  vfat  umask=0077         0  1"
  fi
} > "${TARGET}/etc/fstab"

rm -f "${TARGET}/var/lib/kos/live-iso" \
      "${TARGET}/var/lib/kos/setup-pending" \
      "${TARGET}/etc/sudoers.d/proxim-live" \
      "${TARGET}/usr/share/applications/org.proxim.Installer.desktop"
mkdir -p "${TARGET}/var/lib/kos"
printf 'user=%s\n' "$USERNAME" > "${TARGET}/var/lib/kos/setup-done"

mount --bind /dev "${TARGET}/dev"
mount --bind /dev/pts "${TARGET}/dev/pts"
mount -t proc proc "${TARGET}/proc"
mount -t sysfs sysfs "${TARGET}/sys"
if [[ -d /sys/firmware/efi/efivars ]]; then
  mount --bind /sys/firmware/efi/efivars "${TARGET}/sys/firmware/efi/efivars" 2>/dev/null || true
fi
if [[ -f /etc/resolv.conf ]]; then
  cp -L /etc/resolv.conf "${TARGET}/etc/resolv.conf" 2>/dev/null || true
fi

export KOS_INST_USER="$USERNAME"
export KOS_INST_FULL="$FULL_NAME"
export KOS_INST_PASS="$PASSWORD"
export KOS_INST_HOST="$HOSTNAME"
export KOS_INST_TZ="$TIMEZONE"
export KOS_INST_AUTO="$AUTOLOGIN"

chroot "$TARGET" python3 - << 'PY'
import os, shutil, subprocess

user = os.environ["KOS_INST_USER"]
full = os.environ["KOS_INST_FULL"]
pw = os.environ["KOS_INST_PASS"]
host = os.environ["KOS_INST_HOST"]
tz = os.environ["KOS_INST_TZ"]
autologin = os.environ["KOS_INST_AUTO"] == "1"

if user != "proxim":
    if subprocess.run(["id", "proxim"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        subprocess.run(["userdel", "-f", "-r", "proxim"], check=False)
    shutil.rmtree("/home/proxim", ignore_errors=True)

if subprocess.run(["id", user], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
    cmd = ["useradd", "-m", "-s", "/bin/bash", "-G", "sudo,adm,audio,video,netdev,plugdev"]
    if full:
        cmd += ["-c", full]
    cmd.append(user)
    subprocess.run(cmd, check=True)
elif full:
    subprocess.run(["chfn", "-f", full, user], check=False)

subprocess.run(["chpasswd"], input=f"{user}:{pw}\n", text=True, check=True)

home = f"/home/{user}"
for rel in (".config/gtk-3.0", ".config/gtk-4.0"):
    src = f"/etc/skel/{rel}"
    dst = f"{home}/{rel}"
    if os.path.isdir(src) and not os.path.exists(dst):
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copytree(src, dst)
os.makedirs(f"{home}/.config/gtk-3.0", exist_ok=True)
with open(f"{home}/.config/gtk-3.0/bookmarks", "w", encoding="utf-8") as bf:
    for folder in ("Desktop", "Documents", "Downloads", "Music", "Pictures", "Public", "Templates", "Videos"):
        os.makedirs(f"{home}/{folder}", exist_ok=True)
        bf.write(f"file://{home}/{folder}\n")
subprocess.run(["chown", "-R", f"{user}:{user}", home], check=False)

with open("/etc/hostname", "w", encoding="utf-8") as fh:
    fh.write(host + "\n")
if os.path.isfile("/etc/hosts"):
    with open("/etc/hosts", encoding="utf-8") as fh:
        hosts_txt = fh.read()
    lines = []
    replaced = False
    for ln in hosts_txt.splitlines():
        if ln.startswith("127.0.1.1"):
            lines.append(f"127.0.1.1\t{host}")
            replaced = True
        else:
            lines.append(ln)
    if not replaced:
        lines.append(f"127.0.1.1\t{host}")
    with open("/etc/hosts", "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")

zoneinfo = f"/usr/share/zoneinfo/{tz}"
if os.path.isfile(zoneinfo):
    with open("/etc/timezone", "w", encoding="utf-8") as fh:
        fh.write(tz + "\n")
    if os.path.lexists("/etc/localtime"):
        os.unlink("/etc/localtime")
    os.symlink(zoneinfo, "/etc/localtime")

for gdm_conf in ("/etc/gdm3/daemon.conf", "/etc/gdm3/custom.conf"):
    if os.path.isfile(gdm_conf):
        with open(gdm_conf, encoding="utf-8") as fh:
            lines = fh.readlines()
        out = [ln for ln in lines if not ln.startswith(("AutomaticLoginEnable=", "AutomaticLogin=", "TimedLoginEnable=", "TimedLogin="))]
        new_lines = []
        inserted = False
        for ln in out:
            new_lines.append(ln)
            if not inserted and ln.strip() == "[daemon]":
                if autologin:
                    new_lines.append("AutomaticLoginEnable=true\n")
                    new_lines.append(f"AutomaticLogin={user}\n")
                else:
                    new_lines.append("AutomaticLoginEnable=false\n")
                inserted = True
        with open(gdm_conf, "w", encoding="utf-8") as fh:
            fh.writelines(new_lines)
PY

if [[ "$DOWNLOAD_UPDATES" == "1" ]]; then
  emit "PCT 0.82"
  emit "MSG Downloading and installing latest system updates…"
  chroot "$TARGET" bash -lc '
    export DEBIAN_FRONTEND=noninteractive
    if apt-get update -qq >/dev/null 2>&1; then
      apt-get upgrade -y --no-install-recommends >/dev/null 2>&1 || true
      apt-get clean >/dev/null 2>&1 || true
    fi
  ' || true
fi

emit "PCT 0.90"
emit "MSG Installing Proxim OS bootloader…"

chroot "$TARGET" bash -lc '
  set -euo pipefail
  systemctl disable mnt-kosdev.mount kos-shell-dev.service 2>/dev/null || true
  if [[ -d /sys/firmware/efi && -n "'"${P_EFI}"'" ]]; then
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=proxim --recheck || \
      grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=proxim --no-nvram --recheck
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --no-nvram --recheck || true
  else
    grub-install --target=i386-pc --recheck "'"${DISK}"'"
  fi
  update-grub
  if [[ -x /usr/libexec/kos-grub-brand ]]; then
    /usr/libexec/kos-grub-brand
  fi
'

emit "PCT 0.98"
emit "MSG Finalizing installation…"
sync
umount -R "$TARGET"
rmdir "$TARGET" 2>/dev/null || true
trap - EXIT

emit "PCT 1.00"
emit "DONE"
