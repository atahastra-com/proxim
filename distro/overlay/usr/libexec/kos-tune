#!/bin/bash
# Quiet background services that fight the desktop for CPU and RAM.
#
# PackageKit must stay unmasked: GNOME Software talks to it over D-Bus to
# install .deb packages. Leaving the unit disabled is fine — D-Bus
# activation starts it on demand.
set +e
systemctl unmask packagekit.service 2>/dev/null
systemctl disable packagekit.service 2>/dev/null
systemctl disable --now packagekit-offline-update.service 2>/dev/null
systemctl mask packagekit-offline-update.service 2>/dev/null
systemctl disable --now apt-daily.timer apt-daily-upgrade.timer \
  man-db.timer e2scrub_all.timer 2>/dev/null

# Quiet hardware/network discovery daemons unused at boot (socket/D-Bus
# activation still brings up CUPS or PC/SC on demand when needed).
systemctl disable --now ModemManager.service cups-browsed.service \
  switcheroo-control.service pcscd.service 2>/dev/null

# Disable background file indexers (Tracker 3 and Debian 13 LocalSearch)
# and Evolution calendar/addressbook background factories.
systemctl --global disable \
  tracker-miner-fs-3.service tracker-miner-rss-3.service \
  tracker-extract-3.service tracker-writeback-3.service \
  localsearch-3.service localsearch-writeback-3.service \
  tinysparql-xdg-portal-3.service 2>/dev/null
systemctl --global disable \
  evolution-addressbook-factory.service \
  evolution-calendar-factory.service \
  evolution-source-registry.service \
  evolution-user-prompter.service 2>/dev/null

# Re-hide Appearance Style/Accent after an apt upgrade of gnome-control-center.
if [[ -x /usr/libexec/kos-appearance ]]; then
  /usr/libexec/kos-appearance
fi
exit 0
