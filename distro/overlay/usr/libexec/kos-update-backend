#!/usr/bin/env python3
"""Backend for the embedded Settings -> Software Update page (TSV & JSON)."""

import base64
import hashlib
import json
import os
import re
import subprocess
import sys
import tarfile
import urllib.error
import urllib.parse
import urllib.request

TSV_MODE = False


def clean_field(val):
    return str(val or '').replace('\t', ' ').replace('\r', ' ').replace('\n', ' ').strip()


def emit_tsv(*fields):
    sys.stdout.write('\t'.join(clean_field(f) for f in fields) + '\n')
    sys.stdout.flush()


def emit(obj):
    if not TSV_MODE:
        sys.stdout.write(json.dumps(obj, ensure_ascii=False) + '\n')
        sys.stdout.flush()
        return
    ev = obj.get('event')
    if ev == 'status':
        os_info = obj.get('os') or {}
        vendor_ch = f"{os_info.get('vendor', 'Atahastra')}  •  Channel: {obj.get('channel', 'stable')}"
        emit_tsv('STATUS', obj.get('state', 'up_to_date'), os_info.get('pretty', 'Proxim OS'), vendor_ch, obj.get('message', ''))
        last = obj.get('last')
        if isinstance(last, dict) and last.get('message'):
            when = last.get('updated_at', '')
            emit_tsv('LAST', last.get('message', ''), f'Last update: {when}' if when else '')
        upd = obj.get('update')
        if isinstance(upd, dict) and upd.get('version'):
            emit_tsv('UPDATE', upd.get('title', ''), upd.get('subtitle', ''))
            for n in upd.get('notes') or []:
                emit_tsv('NOTE', f'•  {n}')
        emit_tsv('DONE')
    elif ev == 'progress':
        emit_tsv('PROGRESS', f"{float(obj.get('fraction', 0.0)):.3f}", obj.get('text', ''))
    elif ev == 'error':
        emit_tsv('ERROR', obj.get('message', 'Update error'))
        emit_tsv('DONE')


def parse_kv_file(path):
    data = {}
    if not os.path.isfile(path):
        return data
    try:
        with open(path, encoding='utf-8') as fh:
            for raw in fh:
                line = raw.strip()
                if not line or line.startswith('#') or '=' not in line:
                    continue
                k, v = line.split('=', 1)
                data[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return data


def get_os_info():
    osr = parse_kv_file('/etc/os-release')
    return {
        'name': osr.get('NAME', 'Proxim OS'),
        'version': osr.get('VERSION_ID') or osr.get('VERSION') or '0.1',
        'pretty': osr.get('PRETTY_NAME', 'Proxim OS 0.1'),
        'vendor': osr.get('VENDOR_NAME', 'Atahastra'),
        'logo': osr.get('LOGO', 'proxim-logo'),
    }


def get_update_config():
    cfg = {
        'UPDATE_URL': 'https://updates.atahastra.com/proxim-os/latest.json',
        'CHANNEL': 'stable',
        'PUBLIC_KEY': '/etc/kos/update-signing.pub',
    }
    for p in (
        '/etc/kos/update.conf',
        '/etc/kos/update.local.conf',
        os.path.expanduser('~/.config/kos/update.conf'),
    ):
        cfg.update(parse_kv_file(p))
    return cfg


def version_key(ver_str):
    parts = re.findall(r'\d+|[a-zA-Z]+', str(ver_str))
    return tuple((0, int(p)) if p.isdigit() else (1, p.lower()) for p in parts)


def is_newer(candidate, current):
    return version_key(candidate) > version_key(current)


def format_bytes(num):
    try:
        n = float(num)
    except (TypeError, ValueError):
        return ''
    if n <= 0:
        return ''
    for unit in ('B', 'KB', 'MB', 'GB'):
        if n < 1024 or unit == 'GB':
            return f'{n:.1f} {unit}' if unit != 'B' else f'{int(n)} B'
        n /= 1024
    return ''


def read_last_status():
    p = '/var/lib/kos-update/last-result.json'
    if not os.path.isfile(p):
        return None
    try:
        with open(p, encoding='utf-8') as fh:
            return json.load(fh)
    except Exception:
        return None


def make_summary(manifest):
    ver = str(manifest.get('version', '')).strip()
    name = manifest.get('name') or f'Proxim OS {ver}'
    released = manifest.get('released', '')
    size_str = format_bytes(manifest.get('size_bytes'))
    sub = '  •  '.join(p for p in (f'Version {ver}', released, size_str) if p)
    notes = manifest.get('notes') or []
    if isinstance(notes, str):
        notes = [l.strip() for l in notes.splitlines() if l.strip()]
    return {
        'version': ver,
        'title': name,
        'subtitle': sub,
        'notes': [str(x) for x in notes],
    }


def check_apt_updates():
    """Fallback online check via apt when custom OTA server is not hosted."""
    try:
        ref = subprocess.run(
            ['pkexec', '/usr/libexec/kos-update-helper', 'apt-refresh'],
            capture_output=True,
            text=True,
            timeout=35,
        )
        if ref.returncode != 0:
            return None
        sim = subprocess.run(
            ['apt-get', '-s', 'upgrade'],
            capture_output=True,
            text=True,
            timeout=15,
        )
        pkgs = []
        for ln in sim.stdout.splitlines():
            if ln.startswith('Inst '):
                parts = ln.split()
                if len(parts) >= 2:
                    pkgs.append(parts[1])
        return pkgs
    except Exception:
        return None


def cmd_check():
    os_info = get_os_info()
    cfg = get_update_config()
    last = read_last_status()

    if os.path.islink('/system-update'):
        meta = {}
        try:
            with open('/var/lib/kos-update/pending.json', encoding='utf-8') as fh:
                meta = json.load(fh)
        except Exception:
            pass
        ver = meta.get('version', '')
        emit({
            'event': 'status',
            'state': 'staged',
            'os': os_info,
            'channel': cfg.get('CHANNEL', 'stable'),
            'message': f"{os_info['name']} {ver} is verified and ready to install on restart." if ver else 'An update is ready to install on restart.',
            'update': make_summary(meta) if meta else None,
            'last': last,
        })
        return 0

    url = cfg.get('UPDATE_URL', '').strip()
    try:
        req = urllib.request.Request(
            url,
            headers={'User-Agent': f"ProximOS-Updater/{os_info['version']}"},
        )
        with urllib.request.urlopen(req, timeout=8) as resp:
            manifest = json.loads(resp.read().decode('utf-8'))
    except Exception:
        pkgs = check_apt_updates()
        if pkgs is None:
            emit({
                'event': 'status',
                'state': 'up_to_date',
                'os': os_info,
                'channel': cfg.get('CHANNEL', 'stable'),
                'message': f"{os_info['pretty']} is up to date (offline).",
                'update': None,
                'last': last,
            })
            return 0
        if not pkgs:
            emit({
                'event': 'status',
                'state': 'up_to_date',
                'os': os_info,
                'channel': cfg.get('CHANNEL', 'stable'),
                'message': f"{os_info['pretty']} is up to date.",
                'update': None,
                'last': last,
            })
            return 0
        manifest = {
            '_apt_upgrade': True,
            'version': f'{len(pkgs)} updates',
            'name': 'System & Security Updates',
            'subtitle': f'{len(pkgs)} package(s) ready to download and install',
            'notes': [f'Updated package: {p}' for p in pkgs[:12]],
        }
        cache_dir = os.path.expanduser('~/.cache/kos')
        os.makedirs(cache_dir, exist_ok=True)
        with open(os.path.join(cache_dir, 'latest-manifest.json'), 'w', encoding='utf-8') as fh:
            json.dump(manifest, fh)
        emit({
            'event': 'status',
            'state': 'available',
            'os': os_info,
            'channel': cfg.get('CHANNEL', 'stable'),
            'message': f'{len(pkgs)} system update(s) available.',
            'update': make_summary(manifest),
            'last': last,
        })
        return 0

    remote_ver = str(manifest.get('version', '')).strip()
    if not remote_ver or not is_newer(remote_ver, os_info['version']):
        emit({
            'event': 'status',
            'state': 'up_to_date',
            'os': os_info,
            'channel': cfg.get('CHANNEL', 'stable'),
            'message': f"{os_info['name']} is up to date.",
            'update': None,
            'last': last,
        })
        return 0

    cache_dir = os.path.expanduser('~/.cache/kos')
    os.makedirs(cache_dir, exist_ok=True)
    with open(os.path.join(cache_dir, 'latest-manifest.json'), 'w', encoding='utf-8') as fh:
        json.dump(manifest, fh)

    emit({
        'event': 'status',
        'state': 'available',
        'os': os_info,
        'channel': cfg.get('CHANNEL', 'stable'),
        'message': f"A new {os_info['name']} update is available.",
        'update': make_summary(manifest),
        'last': last,
    })
    return 0


def cmd_inspect_file(bundle_path):
    os_info = get_os_info()
    cfg = get_update_config()
    try:
        with tarfile.open(bundle_path, 'r:gz') as tf:
            manifest = None
            for name in ('manifest.json', './manifest.json'):
                try:
                    m = tf.getmember(name)
                    fh = tf.extractfile(m)
                    if fh:
                        manifest = json.loads(fh.read().decode('utf-8'))
                        break
                except KeyError:
                    continue
        if not manifest:
            raise ValueError('missing manifest.json')
        manifest['size_bytes'] = os.path.getsize(bundle_path)
        manifest['_local_bundle'] = os.path.abspath(bundle_path)
    except Exception as exc:
        emit({'event': 'error', 'message': f'Invalid update bundle: {exc}'})
        return 1

    cache_dir = os.path.expanduser('~/.cache/kos')
    os.makedirs(cache_dir, exist_ok=True)
    with open(os.path.join(cache_dir, 'latest-manifest.json'), 'w', encoding='utf-8') as fh:
        json.dump(manifest, fh)

    emit({
        'event': 'status',
        'state': 'local_ready',
        'os': os_info,
        'channel': cfg.get('CHANNEL', 'stable'),
        'message': f"Ready to install {os_info['name']} {manifest.get('version', '')} on restart.",
        'update': make_summary(manifest),
        'last': read_last_status(),
    })
    return 0


def cmd_pick_file():
    """Open a native GTK4 file chooser for a .pxu bundle and inspect it."""
    try:
        import gi
        gi.require_version('Gtk', '4.0')
        from gi.repository import Gio, GLib, Gtk

        chosen = {'path': None}
        loop = GLib.MainLoop()

        def on_activate(app):
            dlg = Gtk.FileDialog(title='Select Proxim OS Update (.pxu)')
            flt = Gtk.FileFilter()
            flt.set_name('Proxim OS Update (*.pxu)')
            flt.add_pattern('*.pxu')
            store = Gio.ListStore.new(Gtk.FileFilter)
            store.append(flt)
            dlg.set_filters(store)

            def on_done(d, res):
                try:
                    gf = d.open_finish(res)
                    if gf and gf.get_path():
                        chosen['path'] = gf.get_path()
                except GLib.Error:
                    pass
                loop.quit()
                app.quit()

            dlg.open(None, None, on_done)

        app = Gtk.Application(application_id=None)
        app.connect('activate', on_activate)
        GLib.idle_add(lambda: (app.activate(), False)[1])
        app.register(None)
        loop.run()
        if chosen['path']:
            return cmd_inspect_file(chosen['path'])
    except Exception as exc:
        emit({'event': 'error', 'message': f'Could not open file chooser: {exc}'})
        return 1
    if TSV_MODE:
        emit_tsv('DONE')
    return 0


def stage_bundle(bundle_path, sig_path=''):
    emit({'event': 'progress', 'fraction': 0.95, 'text': 'Verifying and staging update…'})
    cmd = ['pkexec', '/usr/libexec/kos-update-helper', 'stage', bundle_path]
    if sig_path:
        cmd.append(sig_path)
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        if proc.returncode in (126, 127):
            emit({'event': 'error', 'message': 'Authentication cancelled.'})
        else:
            err = (proc.stderr or proc.stdout or '').strip()
            emit({'event': 'error', 'message': f'Staging failed: {err}'})
        return 1
    emit({'event': 'progress', 'fraction': 1.0, 'text': 'Staged for restart'})
    return cmd_check()


def cmd_install():
    os_info = get_os_info()
    cfg = get_update_config()
    manifest_file = os.path.expanduser('~/.cache/kos/latest-manifest.json')
    if not os.path.isfile(manifest_file):
        emit({'event': 'error', 'message': 'No update selected. Check for updates first.'})
        return 1
    with open(manifest_file, encoding='utf-8') as fh:
        manifest = json.load(fh)

    if manifest.get('_apt_upgrade'):
        emit({'event': 'progress', 'fraction': 0.25, 'text': 'Downloading and installing system updates…'})
        proc = subprocess.run(
            ['pkexec', '/usr/libexec/kos-update-helper', 'apt-upgrade'],
            capture_output=True,
            text=True,
        )
        if proc.returncode != 0:
            err = (proc.stderr or proc.stdout or 'System update failed.').strip()
            emit({'event': 'error', 'message': err})
            return 1
        emit({'event': 'progress', 'fraction': 1.0, 'text': 'System updated'})
        return cmd_check()

    local_bundle = manifest.get('_local_bundle')
    if local_bundle and os.path.isfile(local_bundle):
        sig = local_bundle + '.sig' if os.path.isfile(local_bundle + '.sig') else ''
        return stage_bundle(local_bundle, sig)

    raw_url = manifest.get('url', '').strip()
    if not raw_url:
        emit({'event': 'error', 'message': 'Update manifest is missing download URL.'})
        return 1

    bundle_url = urllib.parse.urljoin(cfg.get('UPDATE_URL', ''), raw_url)
    expected_sha = manifest.get('sha256', '').strip().lower()
    sig_b64 = manifest.get('signature', '').strip()
    ver = manifest.get('version', 'next')

    dl_dir = os.path.expanduser('~/.cache/kos/updates')
    os.makedirs(dl_dir, exist_ok=True)
    dest_path = os.path.join(dl_dir, f'proxim-os-{ver}.pxu')
    sig_path = dest_path + '.sig'

    try:
        req = urllib.request.Request(
            bundle_url,
            headers={'User-Agent': f"ProximOS-Updater/{os_info['version']}"},
        )
        hasher = hashlib.sha256()
        emit({'event': 'progress', 'fraction': 0.02, 'text': 'Connecting…'})
        with urllib.request.urlopen(req, timeout=30) as resp, open(dest_path + '.part', 'wb') as out:
            total = int(resp.headers.get('Content-Length') or manifest.get('size_bytes') or 0)
            done = 0
            last_pct = -1
            while True:
                chunk = resp.read(65536)
                if not chunk:
                    break
                out.write(chunk)
                hasher.update(chunk)
                done += len(chunk)
                if total > 0:
                    pct = int(done * 100 / total)
                    if pct != last_pct:
                        last_pct = pct
                        emit({
                            'event': 'progress',
                            'fraction': min(0.92, done / total * 0.92),
                            'text': f'Downloading… {format_bytes(done)} / {format_bytes(total)} ({pct}%)',
                        })
        got_sha = hasher.hexdigest().lower()
        if expected_sha and got_sha != expected_sha:
            os.unlink(dest_path + '.part')
            raise ValueError('SHA-256 checksum mismatch')
        os.replace(dest_path + '.part', dest_path)

        written_sig = ''
        if sig_b64:
            with open(sig_path, 'wb') as sf:
                sf.write(base64.b64decode(sig_b64))
            written_sig = sig_path
    except Exception as exc:
        emit({'event': 'error', 'message': f'Download failed: {exc}'})
        return 1

    return stage_bundle(dest_path, written_sig)


def cmd_cancel():
    subprocess.run(['pkexec', '/usr/libexec/kos-update-helper', 'cancel'], check=False)
    return cmd_check()


def main():
    global TSV_MODE
    os.environ.pop('LD_PRELOAD', None)
    args = [a for a in sys.argv[1:] if a != '--tsv']
    if '--tsv' in sys.argv[1:]:
        TSV_MODE = True
    action = args[0] if args else 'check'
    if action == 'check':
        return cmd_check()
    if action == 'inspect' and len(args) > 1:
        return cmd_inspect_file(args[1])
    if action == 'pick':
        return cmd_pick_file()
    if action == 'install':
        return cmd_install()
    if action == 'cancel':
        return cmd_cancel()
    emit({'event': 'error', 'message': f'Unknown command: {action}'})
    return 1


if __name__ == '__main__':
    sys.exit(main())
