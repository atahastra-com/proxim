#!/bin/bash
# Idempotent. Hide the Style and Accent Color groups on Settings >
# Appearance, refreshing the overlay from the installed
# gnome-control-center so an apt upgrade cannot bring the rows back.
#
# The C template still binds default_toggle, dark_toggle and accent_box,
# so the groups are hidden rather than removed. color-scheme and
# accent-color are locked separately via dconf; existing user values
# are reset first because a lock does not override a value already in
# the user db.
#
# Safe without network. Called from a fresh build and from distro-update
# even when KOS_SKIP_APT=1, and from kos-tune on boot.
set -euo pipefail

OVERLAY_ROOT=/usr/share/kos/gresource-overlays
OVERLAY_DIR="${OVERLAY_ROOT}/background"
OVERLAY_UI="${OVERLAY_DIR}/cc-background-panel.ui"
RESOURCE_PATH=/org/gnome/control-center/background/cc-background-panel.ui
# GLib format is resource-path=filesystem-path (gio/gresource.c).
OVERLAY_SPEC="${RESOURCE_PATH%/*}=${OVERLAY_DIR}"

log() { echo "kos-appearance: $*"; }

have_resource() {
  local f="$1" line
  [[ -f "$f" ]] || return 1
  command -v gresource >/dev/null || return 1
  # Don't pipe gresource into grep -q: pipefail + SIGPIPE looks like a miss
  # once the match is found mid-stream.
  while IFS= read -r line; do
    [[ "$line" == "$RESOURCE_PATH" ]] && return 0
  done < <(gresource list "$f" 2>/dev/null || true)
  return 1
}

find_source() {
  local f
  for f in /usr/bin/gnome-control-center.real /usr/bin/gnome-control-center /usr/libexec/gnome-control-center; do
    if have_resource "$f"; then
      printf '%s\n' "$f"
      return 0
    fi
  done
  # Standalone gresource, if a future package split moves the UI out of the binary.
  while IFS= read -r f; do
    if have_resource "$f"; then
      printf '%s\n' "$f"
      return 0
    fi
  done < <(find /usr/lib /usr/libexec /usr/share/gnome-control-center -type f \( -name '*.gresource' -o -name 'gnome-control-center*' \) 2>/dev/null | head -50)
  return 1
}

patch_ui() {
  python3 - "$1" "$2" << 'PY'
import re, sys, os

src, dest = sys.argv[1], sys.argv[2]
text = open(src, encoding="utf-8").read()

def hide(blob, title):
    pat = re.compile(
        r'(<object class="AdwPreferencesGroup">)(\s*)'
        r'(?:<property name="visible">(?:False|0|false)</property>\s*)?'
        r'(<property name="title"[^>]*>' + re.escape(title) + r'</property>)',
        re.S,
    )
    new, n = pat.subn(
        lambda m: f'{m.group(1)}{m.group(2)}<property name="visible">False</property>{m.group(2)}{m.group(3)}',
        blob,
        count=1,
    )
    if n != 1:
        raise SystemExit(f"could not hide {title!r} group (matches={n})")
    return new

text = hide(text, "Style")
text = hide(text, "Accent Color")
marker = "<!-- kos: Style and Accent Color groups are hidden. Regenerated by kos-appearance. -->\n"
if marker not in text:
    if text.startswith("<?xml"):
        first, rest = text.split("\n", 1)
        text = first + "\n" + marker + rest
    else:
        text = marker + text

tmp = dest + ".tmp"
os.makedirs(os.path.dirname(dest), exist_ok=True)
with open(tmp, "w", encoding="utf-8") as fh:
    fh.write(text)
os.replace(tmp, dest)
PY
}

find_ui_resource() {
  local f="$1" pattern="$2" line
  [[ -f "$f" ]] || return 1
  command -v gresource >/dev/null || return 1
  while IFS= read -r line; do
    case "$line" in
      $pattern)
        printf '%s\n' "$line"
        return 0
        ;;
    esac
  done < <(gresource list "$f" 2>/dev/null || true)
  return 1
}

patch_system_panel_ui() {
  python3 - "$1" "$2" "$3" << 'PY'
import os, sys
import xml.etree.ElementTree as ET

src, dest, btn_id = sys.argv[1], sys.argv[2], sys.argv[3]
raw = open(src, encoding="utf-8").read()
root = ET.fromstring(raw)
parent_map = {child: parent for parent in root.iter() for child in parent}

def set_prop(obj_el, prop_name, prop_val):
    for p in obj_el.findall("property"):
        if p.get("name") == prop_name:
            p.text = prop_val
            p.attrib.pop("translatable", None)
            return
    p = ET.Element("property", {"name": prop_name})
    p.text = prop_val
    obj_el.insert(0, p)

def count_row_objects(container_obj):
    n = 0
    for desc in container_obj.iter("object"):
        if desc is container_obj:
            continue
        cls = desc.get("class", "")
        if "Row" in cls:
            n += 1
    return n

# 1) Hide GNOME's stock "Software Updates" row (and its enclosing group/box if
#    it is the only row inside that group) using both visible=False and
#    widget name="kos-hide-me" (enforced at runtime on map by libkos-settings-update.so).
for obj in list(root.iter("object")):
    if obj.get("id") == btn_id:
        continue
    is_stock_updates = False
    for p in obj.findall("property"):
        if p.get("name") == "title" and p.text:
            clean_title = p.text.replace("_", "").strip()
            if clean_title == "Software Updates":
                is_stock_updates = True
                break
    oid = (obj.get("id") or "").lower()
    if oid in ("software_updates_row", "updates_row", "software_update_row"):
        is_stock_updates = True
    if not is_stock_updates:
        continue

    set_prop(obj, "visible", "False")
    set_prop(obj, "name", "kos-hide-me")

    # Walk up to enclosing AdwPreferencesGroup / GtkListBox; if this was the
    # sole row in that group, hide the group too so no empty gap remains.
    cur = obj
    while cur in parent_map:
        cur = parent_map[cur]
        if cur.tag == "object" and cur.get("class") in ("AdwPreferencesGroup", "GtkListBox", "GtkBox"):
            if count_row_objects(cur) <= 1:
                set_prop(cur, "visible", "False")
                set_prop(cur, "name", "kos-hide-me")
            if cur.get("class") == "AdwPreferencesGroup":
                break

# 2) Inject our embedded Proxim OS "Software Update" group before the first
#    existing AdwPreferencesGroup if not already present.
already = any(o.get("id") == btn_id for o in root.iter("object"))
if not already:
    snippet_el = ET.fromstring(
        f'<child>'
        f'  <object class="AdwPreferencesGroup">'
        f'    <child>'
        f'      <object class="AdwActionRow">'
        f'        <property name="title">Software Update</property>'
        f'        <property name="subtitle">Proxim OS updates and release notes</property>'
        f'        <property name="activatable-widget">{btn_id}</property>'
        f'        <child type="prefix">'
        f'          <object class="GtkImage">'
        f'            <property name="icon-name">software-update-available-symbolic</property>'
        f'          </object>'
        f'        </child>'
        f'        <child type="suffix">'
        f'          <object class="GtkButton" id="{btn_id}">'
        f'            <property name="name">kos-open-software-update-btn</property>'
        f'            <property name="valign">center</property>'
        f'            <style><class name="flat"/></style>'
        f'            <child>'
        f'              <object class="GtkImage">'
        f'                <property name="icon-name">go-next-symbolic</property>'
        f'              </object>'
        f'            </child>'
        f'          </object>'
        f'        </child>'
        f'      </object>'
        f'    </child>'
        f'  </object>'
        f'</child>'
    )
    inserted = False
    for parent in root.iter():
        children = list(parent)
        for idx, ch in enumerate(children):
            if ch.tag == "child":
                first_obj = ch.find("object")
                if first_obj is not None and first_obj.get("class") == "AdwPreferencesGroup":
                    parent.insert(idx, snippet_el)
                    inserted = True
                    break
        if inserted:
            break
    if not inserted:
        raise SystemExit("could not locate AdwPreferencesGroup container in System panel UI")

ET.indent(root, space="  ")
xml_out = '<?xml version="1.0" encoding="UTF-8"?>\n<!-- kos: Embedded Software Update configured by kos-appearance. -->\n' + ET.tostring(root, encoding="unicode") + "\n"
ET.fromstring(xml_out)

tmp = dest + ".tmp"
os.makedirs(os.path.dirname(dest), exist_ok=True)
with open(tmp, "w", encoding="utf-8") as fh:
    fh.write(xml_out)
os.replace(tmp, dest)
PY
}

write_env_files() {
  local spec="$1" f
  for f in /etc/environment.d/90-kos-appearance.conf /usr/lib/environment.d/90-kos-appearance.conf; do
    mkdir -p "$(dirname "$f")"
    cat > "$f" << ENV
# GLib format is resource-path=filesystem-path (see gio/gresource.c).
G_RESOURCE_OVERLAYS=${spec}
ENV
  done
}

install_wrapper() {
  local target=/usr/bin/gnome-control-center
  local real=/usr/bin/gnome-control-center.real
  # No package, nothing to wrap.
  [[ -e "$target" || -e "$real" ]] || return 0
  if [[ -f "$target" ]] && ! grep -q KOS_APPEARANCE_WRAPPER "$target" 2>/dev/null; then
    if [[ ! -e "$real" ]]; then
      if ! dpkg-divert --local --divert "$real" --rename --add "$target"; then
        log "WARN: could not divert ${target}"
        return 0
      fi
    fi
  fi
  if [[ ! -e "$real" ]]; then
    log "WARN: diverted binary ${real} missing"
    return 0
  fi
  cat > "$target" << WRAP
#!/bin/bash
# KOS_APPEARANCE_WRAPPER
# GLib wants resource-path=filesystem-path, not the reverse.
export G_RESOURCE_OVERLAYS="${OVERLAY_SPEC}\${G_RESOURCE_OVERLAYS:+:\$G_RESOURCE_OVERLAYS}"
if [[ -f /usr/lib/kos/libkos-settings-update.so ]]; then
  export LD_PRELOAD="/usr/lib/kos/libkos-settings-update.so\${LD_PRELOAD:+:\$LD_PRELOAD}"
fi
exec /usr/bin/gnome-control-center.real "\$@"
WRAP
  chmod 755 "$target"
  log "installed gnome-control-center wrapper"
}

# User dconf wins for reads even after a lock, so a pre-existing pink
# accent (or a light scheme) would stick. Drop the locks briefly, write
# the kos defaults, then lock again.
force_color_defaults() {
  local lockdir=/etc/dconf/db/local.d/locks
  local lockfile="${lockdir}/00-kos"
  local saved="" home user uid
  command -v dconf >/dev/null || { log "WARN: dconf not installed, cannot reset/lock colors"; return 0; }
  mkdir -p "$lockdir"
  if [[ -f "$lockfile" ]]; then
    saved="$(mktemp)"
    cp -a "$lockfile" "$saved"
    rm -f "$lockfile"
    dconf update || true
  fi
  for home in /home/*; do
    [[ -d "$home" ]] || continue
    user="$(basename "$home")"
    id "$user" >/dev/null 2>&1 || continue
    uid="$(id -u "$user")"
    mkdir -p "/run/user/${uid}"
    chown "$user:$user" "/run/user/${uid}" 2>/dev/null || true
    # One short session; dbus-run-session can otherwise hang in a chroot.
    if timeout 20 env XDG_RUNTIME_DIR="/run/user/${uid}" \
         sudo -u "$user" dbus-run-session -- bash -c \
         "dconf write /org/gnome/desktop/interface/color-scheme \"'prefer-dark'\" &&
          dconf write /org/gnome/desktop/interface/accent-color \"'blue'\""; then
      log "reset color-scheme and accent-color for ${user}"
    else
      log "WARN: could not reset color keys for ${user}"
    fi
  done
  if [[ -n "$saved" && -f "$saved" ]]; then
    mv -f "$saved" "$lockfile"
  fi
  dconf update || true
}

mkdir -p "$OVERLAY_DIR"

src=""
if src="$(find_source)"; then
  tmp="$(mktemp)"
  about_tmp="$(mktemp)"
  # shellcheck disable=SC2064
  trap 'rm -f "$tmp" "$about_tmp"' EXIT
  if gresource extract "$src" "$RESOURCE_PATH" > "$tmp" && [[ -s "$tmp" ]]; then
    if patch_ui "$tmp" "$OVERLAY_UI"; then
      log "hid Style and Accent Color from ${src}"
    else
      log "WARN: could not patch ${RESOURCE_PATH} from ${src}"
    fi
  else
    log "WARN: could not extract ${RESOURCE_PATH} from ${src}"
  fi

  add_spec() {
    local entry="$1"
    case ":${OVERLAY_SPEC}:" in
      *":${entry}:"*) ;;
      *) OVERLAY_SPEC="${OVERLAY_SPEC}:${entry}" ;;
    esac
  }

  # Clean up any old About-page duplicate overlay so Software Update appears
  # only once at the top of Settings -> System.
  rm -rf "${OVERLAY_ROOT}/about" "${OVERLAY_ROOT}/system/about"

  if ui_res="$(find_ui_resource "$src" "*/cc-system-panel.ui")"; then
    rel="${ui_res#/org/gnome/control-center/}"
    ui_dest="${OVERLAY_ROOT}/${rel}"
    ui_dir="$(dirname "$ui_dest")"
    if gresource extract "$src" "$ui_res" > "$about_tmp" && [[ -s "$about_tmp" ]]; then
      if patch_system_panel_ui "$about_tmp" "$ui_dest" "kos_sys_software_update_btn"; then
        add_spec "${ui_res%/*}=${ui_dir}"
        log "configured Software Update row and hid stock Software Updates in ${ui_res}"
      else
        log "WARN: skipping Software Update overlay for ${ui_res}"
      fi
    fi
  fi
else
  log "WARN: gnome-control-center appearance UI not found"
fi

install_wrapper
write_env_files "$OVERLAY_SPEC"

if [[ -s "$OVERLAY_UI" ]]; then
  log "overlay in place at ${OVERLAY_UI}"
else
  log "WARN: no appearance overlay installed"
fi

force_color_defaults
exit 0
