#!/bin/bash
# Idempotent. Hide the Style and Accent Color groups on Settings >
# Appearance, refreshing the overlay from the installed
# gnome-control-center so an apt upgrade cannot bring the rows back.
#
# The C template still binds default_toggle, dark_toggle and accent_box,
# so the groups are hidden rather than removed. color-scheme and
# accent-color are locked separately via dconf; existing user values
# are reset first because a lock does not override a value already in
# the user db.
#
# Safe without network. Called from a fresh build and from distro-update
# even when KOS_SKIP_APT=1, and from kos-tune on boot.
set -euo pipefail

OVERLAY_DIR=/usr/share/kos/gresource-overlays/background
OVERLAY_UI="${OVERLAY_DIR}/cc-background-panel.ui"
RESOURCE_PATH=/org/gnome/control-center/background/cc-background-panel.ui
# GLib format is resource-path=filesystem-path (gio/gresource.c).
OVERLAY_SPEC="${RESOURCE_PATH%/*}=${OVERLAY_DIR}"

log() { echo "kos-appearance: $*"; }

have_resource() {
  local f="$1" line
  [[ -f "$f" ]] || return 1
  command -v gresource >/dev/null || return 1
  # Don't pipe gresource into grep -q: pipefail + SIGPIPE looks like a miss
  # once the match is found mid-stream.
  while IFS= read -r line; do
    [[ "$line" == "$RESOURCE_PATH" ]] && return 0
  done < <(gresource list "$f" 2>/dev/null || true)
  return 1
}

find_source() {
  local f
  for f in /usr/bin/gnome-control-center.real /usr/bin/gnome-control-center /usr/libexec/gnome-control-center; do
    if have_resource "$f"; then
      printf '%s\n' "$f"
      return 0
    fi
  done
  # Standalone gresource, if a future package split moves the UI out of the binary.
  while IFS= read -r f; do
    if have_resource "$f"; then
      printf '%s\n' "$f"
      return 0
    fi
  done < <(find /usr/lib /usr/libexec /usr/share/gnome-control-center -type f \( -name '*.gresource' -o -name 'gnome-control-center*' \) 2>/dev/null | head -50)
  return 1
}

patch_ui() {
  python3 - "$1" "$2" << 'PY'
import re, sys, os

src, dest = sys.argv[1], sys.argv[2]
text = open(src, encoding="utf-8").read()

def hide(blob, title):
    pat = re.compile(
        r'(<object class="AdwPreferencesGroup">)(\s*)'
        r'(?:<property name="visible">(?:False|0|false)</property>\s*)?'
        r'(<property name="title"[^>]*>' + re.escape(title) + r'</property>)',
        re.S,
    )
    new, n = pat.subn(
        lambda m: f'{m.group(1)}{m.group(2)}<property name="visible">False</property>{m.group(2)}{m.group(3)}',
        blob,
        count=1,
    )
    if n != 1:
        raise SystemExit(f"could not hide {title!r} group (matches={n})")
    return new

text = hide(text, "Style")
text = hide(text, "Accent Color")
marker = "<!-- kos: Style and Accent Color groups are hidden. Regenerated by kos-appearance. -->\n"
if marker not in text:
    if text.startswith("<?xml"):
        first, rest = text.split("\n", 1)
        text = first + "\n" + marker + rest
    else:
        text = marker + text

tmp = dest + ".tmp"
os.makedirs(os.path.dirname(dest), exist_ok=True)
with open(tmp, "w", encoding="utf-8") as fh:
    fh.write(text)
os.replace(tmp, dest)
PY
}

install_wrapper() {
  local target=/usr/bin/gnome-control-center
  local real=/usr/bin/gnome-control-center.real
  # No package, nothing to wrap.
  [[ -e "$target" || -e "$real" ]] || return 0
  if [[ -f "$target" ]] && ! grep -q KOS_APPEARANCE_WRAPPER "$target" 2>/dev/null; then
    if [[ ! -e "$real" ]]; then
      if ! dpkg-divert --local --divert "$real" --rename --add "$target"; then
        log "WARN: could not divert ${target}"
        return 0
      fi
    fi
  fi
  if [[ ! -e "$real" ]]; then
    log "WARN: diverted binary ${real} missing"
    return 0
  fi
  cat > "$target" << WRAP
#!/bin/bash
# KOS_APPEARANCE_WRAPPER
# GLib wants resource-path=filesystem-path, not the reverse.
export G_RESOURCE_OVERLAYS="${OVERLAY_SPEC}\${G_RESOURCE_OVERLAYS:+:\$G_RESOURCE_OVERLAYS}"
exec /usr/bin/gnome-control-center.real "\$@"
WRAP
  chmod 755 "$target"
  log "installed gnome-control-center wrapper"
}

# User dconf wins for reads even after a lock, so a pre-existing pink
# accent (or a light scheme) would stick. Drop the locks briefly, write
# the kos defaults, then lock again.
force_color_defaults() {
  local lockdir=/etc/dconf/db/local.d/locks
  local lockfile="${lockdir}/00-kos"
  local saved="" home user uid
  command -v dconf >/dev/null || { log "WARN: dconf not installed, cannot reset/lock colors"; return 0; }
  mkdir -p "$lockdir"
  if [[ -f "$lockfile" ]]; then
    saved="$(mktemp)"
    cp -a "$lockfile" "$saved"
    rm -f "$lockfile"
    dconf update || true
  fi
  for home in /home/*; do
    [[ -d "$home" ]] || continue
    user="$(basename "$home")"
    id "$user" >/dev/null 2>&1 || continue
    uid="$(id -u "$user")"
    mkdir -p "/run/user/${uid}"
    chown "$user:$user" "/run/user/${uid}" 2>/dev/null || true
    # One short session; dbus-run-session can otherwise hang in a chroot.
    if timeout 20 env XDG_RUNTIME_DIR="/run/user/${uid}" \
         sudo -u "$user" dbus-run-session -- bash -c \
         "dconf write /org/gnome/desktop/interface/color-scheme \"'prefer-dark'\" &&
          dconf write /org/gnome/desktop/interface/accent-color \"'blue'\""; then
      log "reset color-scheme and accent-color for ${user}"
    else
      log "WARN: could not reset color keys for ${user}"
    fi
  done
  if [[ -n "$saved" && -f "$saved" ]]; then
    mv -f "$saved" "$lockfile"
  fi
  dconf update || true
}

mkdir -p "$OVERLAY_DIR"
install_wrapper

src=""
if src="$(find_source)"; then
  tmp="$(mktemp)"
  # shellcheck disable=SC2064
  trap 'rm -f "$tmp"' EXIT
  if gresource extract "$src" "$RESOURCE_PATH" > "$tmp" && [[ -s "$tmp" ]]; then
    if patch_ui "$tmp" "$OVERLAY_UI"; then
      log "hid Style and Accent Color from ${src}"
    else
      log "WARN: could not patch ${RESOURCE_PATH} from ${src}"
    fi
  else
    log "WARN: could not extract ${RESOURCE_PATH} from ${src}"
  fi
else
  log "WARN: gnome-control-center appearance UI not found"
fi

if [[ -s "$OVERLAY_UI" ]]; then
  log "overlay in place at ${OVERLAY_UI}"
else
  log "WARN: no appearance overlay installed"
fi

force_color_defaults
exit 0
