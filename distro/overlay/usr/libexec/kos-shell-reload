#!/bin/bash
# Watch the kos-shell extension directory and reload it in the running
# GNOME session. This is the guest half of ./build.sh distro-dev:
# the host directory is bind-mounted here, so saving a CSS/JS file on the
# host should refresh the extension in about a second.
#
# 9p shares often do not fire inotify events, so we always poll file
# mtimes as well. If inotify-tools is installed, we also reload on
# inotify so a local (non-9p) edit is picked up immediately.
set -u
DIR=/usr/share/gnome-shell/extensions/kos-shell@kos
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

for _ in $(seq 1 60); do
  [[ -S "${XDG_RUNTIME_DIR}/bus" ]] && break
  sleep 1
done

reload() {
  echo "kos-shell-reload: reloading kos-shell@kos"
  gnome-extensions disable kos-shell@kos >/dev/null 2>&1 || true
  gnome-extensions enable kos-shell@kos >/dev/null 2>&1 || true
}

hash_dir() {
  # Path + mtime + size; cheap and works on 9p.
  find "$DIR" -type f \( -name '*.css' -o -name '*.js' -o -name '*.json' \) -printf '%P %T@ %s\n' 2>/dev/null | sort | md5sum
}

# Optional fast path.
if command -v inotifywait >/dev/null; then
  inotifywait -m -q -e modify,close_write,create,delete,move,attrib --exclude '\.git' -r "$DIR" 2>/dev/null |
  while read -r _; do
    sleep 0.4
    reload
  done &
fi

prev=$(hash_dir)
while true; do
  sleep 1
  cur=$(hash_dir)
  if [[ "$cur" != "$prev" ]]; then
    prev=$cur
    reload
  fi
done
